{
  "name": "postwave-audit-portal",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Moosewave embeddable customer-facing audit portal with one-time bootstrap exchange and an HttpOnly read-only session.",
  "scripts": {
    "dev": "vite --port 1421",
    "build": "tsc -b && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "^5.6.0",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  }
}
