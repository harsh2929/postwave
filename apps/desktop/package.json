{
  "name": "postwave-desktop-shell",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Moosewave Desktop frontend — bundled React dashboard for the Tauri native shell.",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:visual": "playwright test -c playwright.config.ts",
    "test:visual:sms-suppressions": "playwright test -c playwright.config.ts tests/visual/sms-suppressions-99p9.spec.ts --reporter=line",
    "test:visual:push-suppressions": "playwright test -c playwright.config.ts tests/visual/push-suppressions-99p9.spec.ts --reporter=line",
    "test:visual:update": "playwright test -c playwright.config.ts --update-snapshots",
    "test:a11y": "playwright test -c playwright-a11y.config.ts",
    "test:performance": "playwright test -c playwright-performance.config.ts",
    "test:renderer": "playwright test -c playwright.config.ts tests/visual/shell-scroll.spec.ts tests/visual/tier23-surfaces.spec.ts tests/visual/roadmap-clickthrough.spec.ts tests/visual/populated-sweep.spec.ts tests/visual/modal-tab-sweep.spec.ts tests/visual/modal-submit-sweep.spec.ts tests/visual/audit-walkthrough.spec.ts",
    "typecheck:renderer-tests": "tsc -p tsconfig.renderer-tests.json",
    "test:stories": "playwright test -c playwright-storybook.config.ts",
    "test:stories:update": "playwright test -c playwright-storybook.config.ts --update-snapshots",
    "typecheck": "tsc -b --pretty false",
    "lint": "pnpm lint:css && pnpm lint:ts",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:ts": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "test:bundle-graph": "node --test scripts/bundle-graph.test.mjs",
    "test:performance-evidence": "node --test scripts/verify-installed-performance.test.mjs",
    "test:performance-contracts": "node --test scripts/bundle-graph.test.mjs scripts/collect-dom-metric.test.mjs scripts/verify-installed-performance.test.mjs",
    "verify:installed-performance": "node scripts/verify-installed-performance.mjs",
    "test:styles-entry": "node --test scripts/styles-entry-contract.test.mjs",
    "test:design-system": "node --test scripts/design-system-guardrails.test.mjs scripts/css-token-reference-contract.test.mjs scripts/interactive-title-contract.test.mjs",
    "check:design-system": "pnpm test:design-system && node scripts/design-system-guardrails.mjs",
    "test:function-quality": "node --test scripts/function-quality-contract.test.mjs",
    "check:function-quality": "pnpm test:function-quality && node scripts/check-function-quality.mjs",
    "test:toast-contract": "node --test scripts/toast-contract.test.mjs",
    "check:toast-contract": "pnpm test:toast-contract && node scripts/toast-contract.mjs",
    "check:source-size": "node --test scripts/source-size-contract.test.mjs scripts/styles-entry-contract.test.mjs && pnpm check:design-system && pnpm check:function-quality && pnpm check:toast-contract && node scripts/check-source-size.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "audit:interactive-titles": "node scripts/interactive-title-inventory.mjs",
    "audit:overlay-owners": "node scripts/overlay-owner-inventory.mjs",
    "audit:rust-dependencies": "node scripts/check-rust-dependencies.mjs",
    "check:rust-dependencies": "pnpm test:rust-dependencies && pnpm audit:rust-dependencies",
    "test:rust-dependencies": "node --test scripts/check-rust-dependencies.test.mjs",
    "release:version-check": "node scripts/validate-release-version.mjs",
    "release:env-check": "node scripts/validate-release-env.mjs"
  },
  "dependencies": {
    "@postwave/ai-disclosure": "workspace:*",
    "@postwave/audit-portal-react": "workspace:*",
    "@postwave/errors": "workspace:*",
    "@postwave/nav": "workspace:*",
    "@postwave/notifications": "workspace:*",
    "@postwave/offline-outbox": "workspace:*",
    "@postwave/onboarding-schema": "workspace:*",
    "@postwave/query-contract": "workspace:*",
    "@postwave/route-map": "workspace:*",
    "@postwave/step-up": "workspace:*",
    "@postwave/telemetry": "workspace:*",
    "@sentry/react": "^10.0.0",
    "@tanstack/query-async-storage-persister": "^5",
    "@tanstack/query-sync-storage-persister": "^5",
    "@tanstack/react-query": "^5",
    "@tanstack/react-query-persist-client": "^5",
    "@tanstack/react-virtual": "3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "idb-keyval": "^6",
    "posthog-js": "^1.250.0",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@postwave/design-tokens": "workspace:*",
    "@postwave/openapi": "workspace:*",
    "@storybook/react": "^8",
    "@storybook/react-vite": "^8",
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.11.4",
    "es-module-lexer": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^20.10.6",
    "http-server": "^14.1.1",
    "storybook": "^8",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "8.0.16",
    "vitest": "^4.1.11"
  }
}
