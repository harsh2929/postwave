{
  "name": "@postwave/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Moosewave mobile app — Expo Router on iOS + Android. AGPL-3.0-only application layer.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "node ./scripts/build-verification-export.mjs",
    "lint": "expo lint",
    "test": "vitest run --environment node && jest --config jest.routes.config.cjs --runInBand",
    "test:routes": "jest --config jest.routes.config.cjs --runInBand",
    "test:coverage": "vitest run --environment node --coverage && jest --config jest.routes.config.cjs --runInBand --coverage",
    "typecheck": "tsc --noEmit",
    "quality:source-budgets": "node ./scripts/check-source-budgets.mjs",
    "quality:export-budgets": "node ./scripts/check-export-budgets.mjs",
    "docs:runtime-check": "node ./scripts/generate-runtime-doc.mjs --check",
    "docs:runtime-generate": "node ./scripts/generate-runtime-doc.mjs --write",
    "quality:doctor": "expo-doctor .",
    "native:prebuild": "expo prebuild --clean",
    "build:ios": "eas build -p ios --profile production",
    "build:android": "eas build -p android --profile production",
    "build:preview:ios": "eas build -p ios --profile preview",
    "build:preview:android": "eas build -p android --profile preview",
    "release:version-check": "node ./scripts/validate-release-version.mjs",
    "release:app-links-check": "node ./scripts/validate-app-links-live.mjs",
    "release:preflight": "node ./scripts/validate-production-env.mjs",
    "eas-build-pre-install": "node ./scripts/validate-production-env.mjs && node ./scripts/check-production-autologin.mjs",
    "upload-sourcemaps": "./scripts/upload-sourcemaps.sh",
    "check:autologin": "node scripts/check-production-autologin.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~55.0.12",
    "@postwave/ai-disclosure": "workspace:*",
    "@postwave/design-tokens": "workspace:*",
    "@postwave/errors": "workspace:*",
    "@postwave/nav": "workspace:*",
    "@postwave/notifications": "workspace:*",
    "@postwave/offline-outbox": "workspace:*",
    "@postwave/onboarding-schema": "workspace:*",
    "@postwave/query-contract": "workspace:*",
    "@postwave/route-map": "workspace:*",
    "@postwave/sdk": "workspace:*",
    "@postwave/step-up": "workspace:*",
    "@postwave/telemetry": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/query-async-storage-persister": "^5.62.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-persist-client": "^5.62.0",
    "expo": "~55.0.31",
    "expo-application": "~55.0.19",
    "expo-background-task": "~55.0.22",
    "expo-camera": "~55.0.23",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-device": "~55.0.21",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-localization": "~55.0.19",
    "expo-notifications": "~55.0.27",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~55.0.18",
    "expo-screen-capture": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-updates": "~55.0.31",
    "expo-web-browser": "~55.0.20",
    "nativewind": "^4.2.3",
    "posthog-react-native": "^4.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react-native": "14.0.1",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint-config-expo": "^55.0.1",
    "expo-doctor": "1.20.0",
    "jest": "29.7.0",
    "jest-expo": "55.0.22",
    "react-test-renderer": "19.2.0",
    "test-renderer": "1.2.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || >=24.3.0"
  }
}
