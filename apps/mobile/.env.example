EXPO_PUBLIC_API_URL=https://api.moosewave.com
# Browser-facing app origin used for public archive/share links.
EXPO_PUBLIC_APP_URL=https://app.moosewave.com
EXPO_PUBLIC_BUILD_PROFILE=development

# Optional production services. Leave unset locally unless you are testing them.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_OWNER=
EXPO_PUBLIC_SENTRY_DSN_MOBILE=
EXPO_PUBLIC_POSTWAVE_RELEASE=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# The App Store listing the iOS forced-upgrade screen opens: the numeric Apple
# ID of the App Store Connect app record, the same number as the ASC_APP_ID
# submit secret. Leave unset locally; the button then opens an App Store
# search. The preflight fails an iOS production build without it.
EXPO_PUBLIC_IOS_APP_STORE_ID=

# Android push (Firebase Cloud Messaging). Path to the google-services.json for
# com.moosewave.app, relative to apps/mobile or absolute. Leave unset unless you
# are testing push on an Android build; EAS builds get it from the EAS file
# variable of the same name. Never commit the file itself.
GOOGLE_SERVICES_JSON=

# Store-review/legal links shown in auth screens and Settings.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://moosewave.com/legal/privacy
EXPO_PUBLIC_TERMS_URL=https://moosewave.com/legal/terms
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://moosewave.com/legal/account-deletion
EXPO_PUBLIC_SUPPORT_URL=https://docs.moosewave.com

# ── Developer auto sign-in (DEVELOPMENT profile only) ─────────────────────
# Fills the sign-in form and submits it once per app launch, so a LAN build
# reinstalled many times a day does not have to be typed into each time.
#
# Only honoured when EXPO_PUBLIC_BUILD_PROFILE is exactly "development": the
# check is an allowlist on the raw literal so the minifier DELETES these values
# from any other bundle rather than merely ignoring them. Never set these in a
# production or preview environment — scripts/check-production-autologin.mjs
# fails the build if you do. Keep real values in .env, which is gitignored.
EXPO_PUBLIC_DEV_AUTOLOGIN=0
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=
