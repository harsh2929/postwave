              "host": "app.moosewave.com",
              "path": "/app/sms"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "moosewave"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://app.moosewave.com"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f0f0f",
          "image": "./assets/splash.png"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e55262",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Moosewave uses the camera to scan QR codes \u2014 for example to add a subscriber from a printed sign-up code \u2014 and, when you choose, to photograph an image for your workspace's asset library.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "@sentry/react-native",
        {
          "project": "postwave-mobile"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withAndroidShareTarget",
      "./plugins/withAppIntents",
      "./plugins/withSwiftUICoreAutolinkFix",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-localization",
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "Moosewave uses your photo library so you can attach an image to a campaign, set a workspace logo, or scan a QR code out of a screenshot.",
          "cameraPermission": "Moosewave uses the camera to scan QR codes \u2014 for example to add a subscriber from a printed sign-up code \u2014 and, when you choose, to photograph an image for your workspace's asset library.",
          "microphonePermission": false
        }
      ],
      "expo-quick-actions"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": "https://app.moosewave.com"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
