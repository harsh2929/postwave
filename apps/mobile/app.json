            },
            {
              "scheme": "https",
              "host": "app.moosewave.com",
              "pathPrefix": "/app/inbound-webhooks"
            },
            {
              "scheme": "https",
              "host": "app.moosewave.com",
              "pathPrefix": "/app/integrations"
            },
            {
              "scheme": "https",
              "host": "app.moosewave.com",
              "pathPrefix": "/app/landing-pages"
            },
