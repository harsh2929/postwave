# Moosewave API gateway — local development defaults.
# Copy to .env and adjust as needed. Never commit real secrets.

PORT=8080
LOG_LEVEL=info

# Listmonk fork (AGPL). Reachable only over HTTP — see LICENSE-BOUNDARY.md.
LISTMONK_URL=http://localhost:9000
# Optional shared tenant destination registry; use the same secret in migration/automation.
LISTMONK_TENANT_ROUTES=
LISTMONK_WEBHOOK_SECRET=

# Track B F01 engagement classifier. Disabled by default. When enabled, API
# startup requires migration 1934 and the immutable v1 machine registry.
# Use a dedicated random key (never an auth/API/webhook secret); recipient,
# message, and link identities are tenant/purpose-separated HMAC commitments.
POSTWAVE_ENABLE_ENGAGEMENT_CLASSIFIER_V2=false
POSTWAVE_ENGAGEMENT_IDENTITY_HMAC_KEY=
POSTWAVE_ENGAGEMENT_IDENTITY_HMAC_KEY_ID=
# Total observation retention. Must exceed the 90-day full-fidelity tier;
# after 90 days the worker clears headers/IP/JA4 while retaining ASN.
POSTWAVE_ENGAGEMENT_OBSERVATION_RETENTION=8760h
POSTWAVE_ENGAGEMENT_RECLASSIFICATION_LEASE_TTL=2m
# Optional stable pod/process label; blank generates a process-local UUID.
POSTWAVE_ENGAGEMENT_RECLASSIFICATION_WORKER_ID=
# Bounded cross-tenant retention supervisor cadence (10s..1h).
POSTWAVE_ENGAGEMENT_RETENTION_SWEEP_INTERVAL=1m

# Canonical subscriber_events -> campaign_report_events compatibility
# projection. Disabled independently of F01. Enabling requires migrations 1959
# and 1964 plus their restricted-role boundaries, and starts writer-side
# dual-run lineage; it does not make the projection authoritative or migrate
# sent/conversion.
POSTWAVE_ENABLE_CAMPAIGN_REPORT_PROJECTION=false

# Scanner-safe poll/RSVP public surface. Disabled by default. Enabling requires
# a dedicated random secret of at least 32 bytes; never reuse POSTWAVE_SENDING_KEK
# or another auth/encryption key. Unknown classifications are retained but do
# not count as votes.
POSTWAVE_ENABLE_CAMPAIGN_POLLS=false
POSTWAVE_POLL_TOKEN_SECRET=

# Postgres for proprietary services.
DATABASE_URL=postgres://postwave_app:postwave_app_dev@localhost:5432/postwave?sslmode=disable
# Optional. Caps the pgxpool size. Defaults: 25 in dev, 50 in production
# (POSTWAVE_ENV / APP_ENV / GO_ENV in {production,prod,prd,live}).
# Surfaces saturation via pw_pgxpool_conns_active / pw_pgxpool_conns_idle.
# DATABASE_MAX_CONNS=50

# Internal services.
MIGRATION_SERVICE_URL=http://localhost:8081
DELIVERABILITY_SERVICE_URL=http://localhost:8082
VOICE_SERVICE_URL=http://localhost:8083
AUTOMATION_SERVICE_URL=http://localhost:8084
POSTWAVE_INTERNAL_API_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
POSTWAVE_PUBLIC_BASE_URL=http://localhost:3000
POSTWAVE_SMS_PROVIDER_CALLBACK_BASE_URL=https://api.example.test
POSTWAVE_SMS_INBOX_CURSOR_KEY=
POSTWAVE_SMS_INBOX_CURSOR_PREVIOUS_KEY=

# Server-side Expo enhanced-push credential. Never expose this through an
# EXPO_PUBLIC_* variable or commit a real token.
EXPO_PUSH_ACCESS_TOKEN=

# Native auth. Production readiness requires a 32-byte HMAC pepper and a
# real transactional mailer. Local Docker may leave POSTWAVE_MAILER unset,
# which uses the dev mailer.
POSTWAVE_AUTH_HMAC_PEPPER=
POSTWAVE_CONSENT_CURSOR_SIGNING_KEY=
POSTWAVE_PII_FINGERPRINT_PEPPER=
POSTWAVE_PII_FINGERPRINT_KEY_VERSION=v1
POSTWAVE_MAILER=
POSTWAVE_AUTH_FROM_ADDRESS=
POSTWAVE_OAUTH_REDIRECT_BASE=http://localhost:8080
POSTWAVE_OAUTH_GOOGLE_CLIENT_ID=
POSTWAVE_OAUTH_GOOGLE_CLIENT_SECRET=

# Sending-token encryption. Generate a 32-byte local value, for example:
# openssl rand -base64 32
POSTWAVE_SENDING_KEK=
DKIM_ROOT_DOMAIN=mail.postwave.local
POSTMARK_ACCOUNT_TOKEN=
POSTMARK_BASE_URL=https://api.postmarkapp.com

# SES.
#
# AWS_SES_REGION MUST name a region where this AWS account has SES PRODUCTION
# ACCESS. Production access is granted per region, not per account, and a
# sandboxed region does not fail loudly: it caps the daily quota (200/day,
# 1/sec) and silently refuses every unverified recipient, which reads as a
# deliverability problem rather than a configuration one. Confirm before use:
#
#   aws sesv2 get-account --region <region> --query ProductionAccessEnabled
#
# A denied production-access request in one region does not affect the others.
AWS_SES_REGION=

# Configuration set applied to every SES send. Campaign Assurance binds an
# outbound MIME hash to a provider receipt, so a send with no configuration
# set produces a delivery attempt that can never be reconciled — the run has
# no provider evidence and the gate cannot settle it. Create the set with an
# event destination BEFORE enabling assurance-bound sending.
POSTWAVE_SES_CONFIGURATION_SET=

# Comma-separated SNS topic ARNs whose SES notifications this API accepts.
# Anything not listed is rejected, so a topic added in the console without
# being added here delivers nothing and logs a rejection.
POSTWAVE_SES_TOPIC_ARNS=

# Envelope sender for VERP reply correlation. Requires a custom MAIL FROM
# domain on the sending identity: without one the Return-Path is an
# amazonses.com address, and F05 reply matching has no per-recipient token to
# recover. Leave empty to disable VERP rather than emit an unmatchable envelope.
POSTWAVE_SENDING_VERP_REPLY_TO=

# Inbound reply SNS topic allow-list, comma separated. When set, the replies
# SES endpoint verifies the SNS signature in ADDITION to its shared secret —
# a secret travels in every request and can leak into a log or a proxy, while a
# signature cannot be replayed onto different content. Empty keeps the previous
# shared-secret-only behaviour so an upgrade does not take a working inbound
# path down. This is the SES RECEIPT topic, not POSTWAVE_SES_TOPIC_ARNS (which
# carries sending events).
POSTWAVE_REPLIES_SES_TOPIC_ARNS=

# Campaign Assurance runtimes. All default OFF; each fails closed when its
# dependencies are absent rather than degrading to an unevidenced pass.
POSTWAVE_ENABLE_CAMPAIGN_ASSURANCE_RUNTIME=
POSTWAVE_ENABLE_CAMPAIGN_ASSURANCE_MODELED=
POSTWAVE_ENABLE_CAMPAIGN_ASSURANCE_IMAGE_BROKER=
# The API consumes exact model/pricing identity but never the provider key or
# Unix sockets. Dedicated worker/sandbox/gateway processes use the same pricing
# identity; see docs/runbooks/campaign-assurance-modeled-runtime.md.
POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_MODEL_ID=
POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_MODEL_VERSION=
POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_PRICING_VERSION=
POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_INPUT_MICROUSD_PER_MILLION_TOKENS=
POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_OUTPUT_MICROUSD_PER_MILLION_TOKENS=
# Provider-gateway process only. Worker/API/model-sandbox reject a nonempty key.
POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_API_KEY=
POSTWAVE_CAMPAIGN_ASSURANCE_MODEL_SANDBOX_SOCKET=/run/postwave/model-worker/model.sock
POSTWAVE_CAMPAIGN_ASSURANCE_PROVIDER_GATEWAY_SOCKET=/run/postwave/model-provider/provider.sock
POSTWAVE_CAMPAIGN_ASSURANCE_MODEL_SANDBOX_UID=10001
POSTWAVE_CAMPAIGN_ASSURANCE_PROVIDER_GATEWAY_UID=10001

# Queue gate rollout: off | shadow | warn | block. The raw-MIME send path only
# activates at `block`; below that the legacy HTML sender still runs, so a
# staged rollout changes what is ENFORCED, not what is SENT, until it reaches
# block. Never jump straight to block without a shadow period.
POSTWAVE_CAMPAIGN_ASSURANCE_GATE_ROLLOUT=

# Runtime security. Dev bypasses are off unless explicitly set to 1.
#
# CORS_ALLOWED_ORIGINS doubles as the CSRF Origin allow-list for any
# state-changing request that carries the `pw_session` cookie (see
# internal/middleware/origin_csrf.go). Origins NOT listed here will
# read GETs fine but their PUT/POST/PATCH/DELETE requests are 403'd
# with `forbidden_origin` — which presents as "Layout save failed" etc.
# in the UI when the desktop is run on a port that isn't listed.
#
# Defaults cover three local dev surfaces:
#   :3000  Next.js marketing/dashboard (apps/web)
#   :5173  Storybook / one-off vite previews
#   :1420  Tauri desktop dev shell (apps/desktop)
# Add your prod web origin(s) and remove the localhost entries for
# production deploys.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:1420
POSTWAVE_TRUST_FORWARDED_IP_HEADERS=0
POSTWAVE_DEV_TENANT_SLUG_HEADER=0
POSTWAVE_DEV_ADMIN_ROLE_HEADER=0
# Drops the Secure attribute from the session cookie. Set this ONLY when a
# client reaches the API over plaintext http on a ROUTABLE host -- a phone or
# simulator with EXPO_PUBLIC_API_URL=http://<lan-ip>:8080. Such a client
# discards a Secure cookie, so login returns 200 and the very next request is
# a 401 that mentions no cookie; apps typically render that as a wrong
# password. Loopback (localhost / 127.0.0.1) is a trustworthy origin and needs
# nothing here, which is why browser-only development never hits this.
# Previously this required POSTWAVE_DEV_TENANT_SLUG_HEADER=1, which also
# opened a dev auth header as a side effect.
POSTWAVE_SESSION_COOKIE_INSECURE=0
POSTWAVE_DEV_LISTMONK_WEBHOOK_BYPASS=0
POSTWAVE_DEV_SHOPIFY_WEBHOOK_BYPASS=0
# Temporary migration switch only. v1 signs timestamp.body and therefore does
# not authenticate X-Postwave-Event-Id; keep disabled for new deployments.
POSTWAVE_ALLOW_LEGACY_INBOUND_SIGNATURE_V1=0
POSTWAVE_LEGACY_INBOUND_SIGNATURE_V1_EXPIRES_AT=
POSTWAVE_ALLOW_MEMORY_FALLBACK=0

# Shopify commerce integration. Leave client credentials empty for local demo
# OAuth URLs; set real app credentials in staging/production.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_customers,read_products,read_orders,read_all_orders
SHOPIFY_OAUTH_REDIRECT_URL=
SHOPIFY_STATE_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# Moosewave billing. Dodo Payments hosts Checkout and the Customer Portal;
# protected environments keep checkout closed until a release approval is set.
BILLING_PROVIDER=dodo
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_WEBHOOK_KEY_SECONDARY=
DODO_PAYMENTS_PRODUCT_ID_LAUNCH_MONTHLY=
DODO_PAYMENTS_PRODUCT_ID_GROWTH_MONTHLY=
DODO_PAYMENTS_PRODUCT_ID_SCALE_MONTHLY=
MOOSEWAVE_BILLING_LAUNCH_APPROVAL=

# Legacy Stripe subscription compatibility for existing/self-hosted installs.
# This is separate from tenant-owned Stripe commerce integrations.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_SECONDARY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_LTD=       # legacy read compatibility only
STRIPE_PRICE_SENDING=   # legacy read compatibility only
STRIPE_PRICE_PRO=       # legacy read compatibility only
STRIPE_API_VERSION=

# Social publishing + ads provider credentials. Empty values keep Mailchimp-
# parity social/ad surfaces visible but fail-closed until real provider creds
# are installed.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v24.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
GOOGLE_ADS_API_BASE_URL=https://googleads.googleapis.com
GOOGLE_ADS_API_VERSION=v24
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_OAUTH_TOKEN_URL=https://www.googleapis.com/oauth2/v3/token

# Public forms and anti-abuse. Configure the matching reCAPTCHA v2 checkbox
# secret/site-key pair together. Full-mode public signup may cross a paid
# verification-provider boundary only after anti-abuse is proven; without both
# keys it degrades to local-only verification and spends no provider credits.
FORMS_PUBLIC_HOST=http://localhost:3000
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=

# Email verification and recipient-health emergency kill switches. These
# runtimes are enabled when the variable is omitted or set to 0; set exactly 1
# and restart the API to disable one boundary independently. Disabling the
# additive recipient-health gate never disables canonical consent/suppression.
POSTWAVE_DISABLE_VERIFICATION_BULK_JOBS=0
POSTWAVE_DISABLE_VERIFICATION_JOB_RUNNER=0
POSTWAVE_DISABLE_SUBSCRIBER_IMPORT_WORKER=0
POSTWAVE_DISABLE_RECIPIENT_HEALTH_GATE=0
# Optional in development, mandatory in production. This must be a private
# clamd TCP endpoint (host:3310) or unix:///path/to/clamd.sock.
POSTWAVE_FORM_UPLOAD_CLAMAV_ADDR=
POSTWAVE_FORM_UPLOAD_TENANT_QUOTA_BYTES=1073741824
POSTWAVE_FORM_UPLOAD_PENDING_LIMIT=100

# Asset-library storage. Local development may leave these empty and uses
# POSTWAVE_DATA_DIR/assets behind the authenticated blob route. Production S3
# requires all three values: keep the bucket private and point the public base
# at an HTTPS CDN/CloudFront distribution with private-bucket OAC.
POSTWAVE_ASSETS_BUCKET=
POSTWAVE_ASSETS_PUBLIC_BASE_URL=
# Tenant export ZIPs use a separate private non-CDN store. Development falls
# back to mode-0600 files beneath POSTWAVE_DATA_DIR/private-exports.
POSTWAVE_EXPORTS_BUCKET=
POSTWAVE_S3_KMS_KEY_ID=

# Campaign Assurance durable runtime and exact-hash send gate. Both default off.
# The durable runtime must be enabled before any send-gate rollout. Rollout is
# one of off, shadow, warn, or block. Shadow/warn evaluate the same exact-hash
# evidence and emit telemetry without binding recipients; block requires the
# raw-RFC822 provider runtime and withholds every unbound/pre-rollout row.
POSTWAVE_ENABLE_CAMPAIGN_ASSURANCE_RUNTIME=false
POSTWAVE_CAMPAIGN_ASSURANCE_GATE_ROLLOUT=off
# Deprecated exact alias for ROLLOUT=block. Do not set it with shadow/warn.
POSTWAVE_ENABLE_CAMPAIGN_ASSURANCE_SEND_GATE=false

# Required together when Campaign Assurance rollout is block. The raw-MIME
# runtime will not start without a versioned keyring and an MX-routed inbound
# domain. Secrets decode from standard base64 to at least 32 bytes. Issuance
# windows may touch but must not overlap; retain retired keys until every token
# they issued has expired. Example JSON shape:
# {"version":"postwave.reply-correlation-keyring.v1","keys":[{"id":"k1","secret_base64":"...","not_before":"2026-01-01T00:00:00Z","not_after":"2027-01-01T00:00:00Z"}]}
POSTWAVE_REPLIES_VERP_KEYRING_JSON=
POSTWAVE_REPLIES_ENVELOPE_DOMAIN=
POSTWAVE_REPLIES_VERP_TTL=2160h

# Campaign Assurance image/OCR runtime. This independent gate defaults off.
# Enabling it is fail-closed: every exact host, Unix-domain service identity,
# versioned private S3 bucket, dedicated KMS key, and migration 1933 must pass
# readiness before the worker receives an image-inspection capability.
POSTWAVE_ENABLE_CAMPAIGN_ASSURANCE_IMAGE_BROKER=false
POSTWAVE_CAMPAIGN_IMAGE_ALLOWED_HOSTS=images.example.com,cdn.example.com
POSTWAVE_CAMPAIGN_IMAGE_OCR_UNIX_SOCKET=/run/postwave/image-ocr/ocr.sock
POSTWAVE_CAMPAIGN_IMAGE_OCR_ENGINE=tesseract
POSTWAVE_CAMPAIGN_IMAGE_OCR_VERSION=5.5.1-eng.sha256.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
POSTWAVE_CAMPAIGN_IMAGE_OCR_CLIENT_UID=10001
POSTWAVE_CAMPAIGN_IMAGE_OCR_CONCURRENCY=2
POSTWAVE_CAMPAIGN_IMAGE_SCANNER_UNIX_SOCKET=/run/postwave/image-scanner/scanner.sock
POSTWAVE_CAMPAIGN_IMAGE_SCANNER_ENGINE=clamav
POSTWAVE_CAMPAIGN_IMAGE_SCANNER_VERSION=1.4.4-db.28107
POSTWAVE_CAMPAIGN_IMAGE_SCANNER_CLIENT_UID=10001
POSTWAVE_CAMPAIGN_IMAGE_SCANNER_CONCURRENCY=2
POSTWAVE_CAMPAIGN_IMAGE_BROKER_UNIX_SOCKET=/run/postwave/image-worker/broker.sock
POSTWAVE_CAMPAIGN_IMAGE_BROKER_DEPLOYMENT_IDENTITY=postwave.campaign-image-broker.local.v1
POSTWAVE_CAMPAIGN_IMAGE_BROKER_SERVER_UID=10001
POSTWAVE_CAMPAIGN_IMAGE_BROKER_SERVER_GID=10001
POSTWAVE_CAMPAIGN_IMAGE_BROKER_SOCKET_UID=10001
POSTWAVE_CAMPAIGN_IMAGE_BROKER_SOCKET_GID=10001
POSTWAVE_CAMPAIGN_IMAGE_BROKER_SOCKET_MODE=0600
POSTWAVE_CAMPAIGN_IMAGE_BROKER_ALLOWED_CLIENT_PEERS=10001:10001
POSTWAVE_CAMPAIGN_IMAGE_EVIDENCE_BUCKET=postwave-campaign-image-evidence
POSTWAVE_CAMPAIGN_IMAGE_EVIDENCE_PREFIX=campaign-assurance/image-evidence/v1
POSTWAVE_CAMPAIGN_IMAGE_EVIDENCE_KMS_KEY_ID=
POSTWAVE_CAMPAIGN_IMAGE_EVIDENCE_RETENTION=720h
POSTWAVE_CAMPAIGN_IMAGE_OCR_CACHE_RETENTION=336h
POSTWAVE_CAMPAIGN_IMAGE_IPC_TIMEOUT=8s
# Optional Cloudflare R2 alternative. Production requires an explicit HTTPS
# public custom domain; never put the private R2 S3 API endpoint here.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=

# Diagnostician, render, seed-list, and DMARC provider settings belong to the
# deliverability sidecar, not the API task. The API owns only the
# DELIVERABILITY_SERVICE_URL boundary declared above.

# SMS pilot providers. Leave empty in local dev unless rehearsing SMS; staging
# and production must configure one provider plus callback verification before
# live sends.
SMS_DEFAULT_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_API_BASE_URL=https://api.twilio.com
TWILIO_MESSAGING_API_BASE_URL=https://messaging.twilio.com
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_URL=
TELNYX_PUBLIC_KEY=
TELNYX_API_BASE_URL=https://api.telnyx.com
BANDWIDTH_ACCOUNT_ID=
BANDWIDTH_API_USERNAME=
BANDWIDTH_API_PASSWORD=
BANDWIDTH_WEBHOOK_TOKEN=
BANDWIDTH_WEBHOOK_USERNAME=
BANDWIDTH_WEBHOOK_PASSWORD=
BANDWIDTH_APPLICATION_ID=
BANDWIDTH_FROM_NUMBER=
BANDWIDTH_API_BASE_URL=https://messaging.bandwidth.com
BANDWIDTH_CAMPAIGN_API_BASE_URL=https://api.bandwidth.com

# PostHog telemetry (server-side, opt-in). Empty = dormant; set to a
# personal API key (phx_...) with posthog:capture scope to enable.
POSTHOG_API_KEY=
POSTHOG_API_HOST=https://eu.posthog.com

# Customer-facing read-only audit portal. Production requires an exact HTTPS
# origin, an independent secret of at least 32 bytes, and a built SPA directory.
# Frame ancestors is 'none', 'self', or exact HTTPS origins (no wildcards).
POSTWAVE_PORTAL_ORIGIN=http://localhost:8080
POSTWAVE_PORTAL_JWT_SECRET=
POSTWAVE_PORTAL_SPA_DIR=../audit-portal/dist
POSTWAVE_PORTAL_FRAME_ANCESTORS='self'

# F01 engagement honeypot. Decoy links that no human can reach, embedded in
# ordinary mail: anything that fetches one is a machine, on a REAL recipient
# rather than a seed, which is the only evidence that can certify machine
# recall without circularity.
#
# BOTH must be set to enable. Empty (the default) means this deployment has
# not opted into embedding decoys in customer mail; a binary upgrade must never
# start doing that on its own. The secret is independent of every other secret
# because the decoy endpoint is unauthenticated and world-reachable — at least
# 32 bytes, and never shared with the seed-callback or action-ticket secrets.
POSTWAVE_ENGAGEMENT_HONEYPOT_SIGNING_SECRET=
POSTWAVE_ENGAGEMENT_HONEYPOT_BASE_URL=
