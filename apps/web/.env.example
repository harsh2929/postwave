# SPDX-License-Identifier: AGPL-3.0-only
# Copy to .env.local and fill in values.

API_URL=http://localhost:8080
POSTWAVE_API_URL=http://localhost:8080
# Legacy/public archive URL escape hatch. Leave unset for app browser builds:
# authenticated browser API calls must stay same-origin through /api.
# NEXT_PUBLIC_API_URL=https://api.postwave.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:3000/docs
POSTWAVE_TENANT_SLUG=
NEXT_PUBLIC_TENANT_SLUG=
NEXT_PUBLIC_POSTWAVE_TENANT_SLUG=

# Request/proxy limits. Empty values use the code defaults.
NEXT_PUBLIC_API_TIMEOUT_MS=15000
POSTWAVE_API_PROXY_TIMEOUT_MS=15000
POSTWAVE_API_STREAM_TIMEOUT_MS=310000
# Dedicated authenticated workspace-export stream lane (default 30 minutes).
POSTWAVE_API_EXPORT_TIMEOUT_MS=1800000
POSTWAVE_API_PROXY_MAX_BODY_BYTES=26214400
POSTWAVE_PUBLIC_PAGE_TIMEOUT_MS=8000
NEXT_PUBLIC_PUBLIC_PAGE_TIMEOUT_MS=8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FORMS_ORIGIN=http://localhost:3000
# Public CDN/base used for sanitized, content-addressed template previews.
# Match the API's POSTWAVE_ASSETS_PUBLIC_BASE_URL in deployed environments.
NEXT_PUBLIC_POSTWAVE_ASSETS_BASE_URL=
# Origin that public form file uploads PUT to (the presigned-upload bucket).
# Production requires the exact bucket origin; local omission fails closed and
# does not authorize any provider-wide wildcard. Set it to the reviewed upload
# origin so the browser can reach only the intended presigned-upload bucket.
NEXT_PUBLIC_POSTWAVE_UPLOAD_ORIGIN=
# Build-time only; the deploy pipeline sets this (a commit SHA is ideal). It
# becomes the service worker's /offline precache revision, so each deploy
# re-fetches that document instead of serving the copy cached on first install
# — which referenced hashed CSS files that no longer exist. A local build falls
# back to a timestamp, so leaving this blank is fine for development.
POSTWAVE_BUILD_ID=

# Local/demo compatibility pages are read-only by default. Enable only in a
# disposable tenant when you want the page to create demo parity records.
NEXT_PUBLIC_USE_MOCKS=0
NEXT_PUBLIC_ENABLE_COMPAT_DEMO_ACTIONS=0
NEXT_PUBLIC_SHOW_HEALTH_DEBUG=0
# Feature toggles: open discount mutations / public self-serve checkout once
# their backends ship. Left off (0) by default.
NEXT_PUBLIC_DISCOUNT_MUTATIONS_ENABLED=0
NEXT_PUBLIC_ENABLE_PUBLIC_CHECKOUT=0
# Lossless semantic-email AST v2 authoring. Existing semantic campaigns remain
# visible and legacy editors cannot overwrite them while this is off.
NEXT_PUBLIC_ENABLE_CAMPAIGN_CONTENT_AST_V2=0

SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN_WEB=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
POSTWAVE_ENV=development
NEXT_PUBLIC_POSTWAVE_ENV=development
POSTWAVE_RELEASE=
NEXT_PUBLIC_POSTWAVE_RELEASE=
# Fail closed by default. Set only after the referenced release record has
# approved public publication; this is server-only and is never a secret.
POSTWAVE_PUBLIC_RELEASE_APPROVAL=
# Independent counsel approval for publishing the linked /legal/* policies.
# The public release gate may not open unless this approval is also present.
POSTWAVE_LEGAL_PUBLICATION_APPROVAL=

# PostHog: empty = telemetry dormant (no events sent). When set, the
# value is exposed to the browser via Next's NEXT_PUBLIC_* prefix and
# embedded in the JS bundle, so use the project API key (phc_...), NOT
# the personal API key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# Consent-ledger write for the marketing cookie banner. Optional locally but
# required by the canonical production image. Use a live public pwk_ key bound
# to the reviewed tenant; tenant identity is resolved server-side.
NEXT_PUBLIC_POSTWAVE_CONSENT_SITE_KEY=
NEXT_PUBLIC_POSTWAVE_API_BASE_URL=

# Public slug of the published marketing-tenant roadmap-feedback form. When set,
# the /roadmap page shows a structured feedback form instead of a mailto link.
NEXT_PUBLIC_ROADMAP_FORM_SLUG=

# Optional Web Push client fallback. Backend-provided VAPID config wins.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional mobile universal/app link association metadata.
POSTWAVE_APPLE_TEAM_ID=
POSTWAVE_IOS_BUNDLE_ID=com.moosewave.app
POSTWAVE_ANDROID_PACKAGE_NAME=com.moosewave.app
POSTWAVE_ANDROID_SHA256_CERT_FINGERPRINTS=

# Dev-only auth/mock shortcuts. These are rejected in production/CI by
# `pnpm --filter @postwave/web env:check`.
POSTWAVE_AUTH_BYPASS=0
POSTWAVE_LOCAL_AUTH_BYPASS=0
