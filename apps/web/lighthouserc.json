{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/pricing",
        "http://localhost:3000/docs/getting-started",
        "http://localhost:3000/status",
        "http://localhost:3000/login"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.98, "aggregationMethod": "pessimistic" }],
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "pessimistic" }],
        "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "pessimistic" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "pessimistic" }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1800, "aggregationMethod": "pessimistic" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "pessimistic" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "pessimistic" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "pessimistic" }],
        "max-potential-fid": ["error", { "maxNumericValue": 130, "aggregationMethod": "pessimistic" }],
        "speed-index": ["error", { "maxNumericValue": 3000, "aggregationMethod": "pessimistic" }],
        "interactive": ["error", { "maxNumericValue": 3500, "aggregationMethod": "pessimistic" }],
        "bootup-time": ["error", { "maxNumericValue": 2000, "aggregationMethod": "pessimistic" }],
        "mainthread-work-breakdown": ["error", { "maxNumericValue": 3000, "aggregationMethod": "pessimistic" }],
        "total-byte-weight": ["error", { "maxNumericValue": 750000, "aggregationMethod": "pessimistic" }],
        "csp-xss": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "color-contrast": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "label-content-name-mismatch": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "document-title": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "meta-description": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}
