{
  "name": "postwave-playwright",
  "private": true,
  "version": "0.0.0",
  "description": "End-to-end browser tests for the Moosewave web app, running against the docker-compose stack.",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:desktop": "playwright test --project=chromium-desktop",
    "test:mobile": "playwright test --project=chromium-mobile",
    "test:performance": "playwright test --config=performance.config.ts",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@axe-core/playwright": "4.12.1"
  }
}
