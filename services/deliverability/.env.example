# Moosewave deliverability sidecar — production credential/config inventory.
# Values stay empty deliberately; provision real secrets through the deployment
# secret store and never commit them.

PORT=8082
POSTWAVE_INTERNAL_API_TOKEN=

# AI diagnosis and cross-client rendering.
GEMINI_API_KEY=
HCTI_USER_ID=
HCTI_API_KEY=
DIAGNOSTICIAN_PROMPTS_PATH=
DIAGNOSTICIAN_EVAL_CASES_PATH=

# Seed-list inbox configuration. The registry contains mailbox metadata while
# passwords are supplied through the per-mailbox secret variables it names.
SEEDLIST_CONNECTOR=imap
SEEDLIST_CONFIG_PATH=
POSTWAVE_SEEDLIST_IMAP_JSON=
# Publish the secret-reference-only registry snapshot to the immutable v1
# ledger before polling or Inbox Reality dispatch. Requires migration 1930 and
# a ready PostgreSQL pool; enabling it rejects legacy plaintext credentials.
POSTWAVE_ENABLE_DURABLE_SEED_REGISTRY=false

# DMARC aggregate-report inbox. The legacy IMAP path is intentionally disabled:
# it cannot prove the SMTP envelope recipient or a trusted authentication
# verdict. Never enable it in production; retain only for isolated migration
# research until the authenticated inbound transport is implemented.
DMARC_IMAP_ALLOW_UNTRUSTED_LEGACY_INGESTION=false
DMARC_IMAP_HOST=
DMARC_IMAP_PORT=993
DMARC_IMAP_USER=
DMARC_IMAP_PASSWORD=
DMARC_IMAP_PASSWORD_SECRET_NAME=
DMARC_IMAP_FOLDER=INBOX
