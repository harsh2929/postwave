# Moosewave migration sidecar — secret names only. Copy to an ignored local env
# file or provision the corresponding production secret references. Never
# commit credential values.

PORT=8081
POSTWAVE_INTERNAL_API_TOKEN=
POSTWAVE_MIGRATION_SESSION_KEK=

# Optional comma-separated exact DNS hostnames for ActiveCampaign Developer-tab
# API URLs outside the built-in api-us1.com and activehosted.com account hosts.
ACTIVECAMPAIGN_ALLOWED_API_HOSTS=

# Provider OAuth applications.
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
CONVERTKIT_CLIENT_ID=
CONVERTKIT_CLIENT_SECRET=

# Migration-only restricted key for paid-subscription source imports. Do not
# reuse the API billing credential.
STRIPE_SECRET_KEY=
