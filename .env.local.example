# =============================================================================
# Moosewave — local development environment (shareable template)
# =============================================================================
#
# Drop this file into a new collaborator's clone and they can bring up the
# full stack with `make dev` (or the manual steps at the bottom).
#
# How to use:
#   1. Copy this file to .env.local at the repo root:
#        cp .env.local.example .env.local
#   2. Generate the few values marked GENERATE_ME (one-liners below).
#   3. Fan it out to each app's expected location — the api/web/desktop
#      apps each look in their own dir:
#        scripts/dev-fanout-env.sh        # if you want to use the helper
#      OR copy manually:
#        cp .env.local apps/api/.env
#        cp .env.local apps/web/.env.local
#        cp .env.local apps/desktop/.env
#   4. Start the stack:
#        docker compose up -d postgres listmonk     # infra
#        make api          # apps/api  (Go gateway on :8080)
#        make web          # apps/web  (Next.js on :3000)
#        make desktop      # apps/desktop (Vite + Tauri on :1420)
#
# Generators (run once, paste the output):
#   openssl rand -hex 32        # 32-byte hex  — auth pepper, KEKs, salts
#   openssl rand -base64 32     # 32-byte b64  — sending KEK, session secrets
#
# Conventions in this file:
#   • LOCAL_DEFAULT  — already set, works out of the box
#   • GENERATE_ME    — run one of the openssl one-liners above
#   • PROVIDE_ME     — only needed if you want that feature on locally
#                      (SSO, Stripe billing, SMS, Mailchimp migration, etc.)
#   • # OPTIONAL     — has a sensible code-side default; leave commented unless overriding
#
# AWS credentials: NOT required for local dev. Every AWS-backed feature has
# a local fallback (KMS → static KEK, S3 → local fs, Secrets Manager → env
# vars, SES → Postmark or dev mailer). The Section 1 "AWS credentials"
# block stays empty unless you specifically want to rehearse an AWS path.
#
# DO NOT commit your filled-in .env.local — it's already in .gitignore.
# =============================================================================


# ────────────────────────────────────────────────────────────────────────────
# Section 0 — Workspace identity (shared by every app)
# ────────────────────────────────────────────────────────────────────────────

POSTWAVE_ENV=development
LOG_LEVEL=info
NODE_ENV=development


# ────────────────────────────────────────────────────────────────────────────
# Section 1 — apps/api  (Go gateway, default port :8080)
# ────────────────────────────────────────────────────────────────────────────

PORT=8080

# Listmonk fork (AGPL) — required for sends. Run via:
#   docker compose up -d listmonk
LISTMONK_URL=http://localhost:9000
LISTMONK_WEBHOOK_SECRET=  # GENERATE_ME (32-byte hex)
# The canonical full local stack binds its isolated Listmonk to the seeded
# demo tenant. Leave shared when using a Listmonk instance across tenants.
LISTMONK_TENANT_MODE=shared
LISTMONK_DEDICATED_TENANT_ID=

# Postgres — the docker-compose ships postwave/postwave_app_dev.
# If you run your own postgres, adjust user/host/port/db.
DATABASE_URL=postgres://postwave_app:postwave_app_dev@localhost:5432/postwave?sslmode=disable

# Ops-console pool — connects as the postwave_ops role created by migration
# 1700_ops_console.sql (NOLOGIN by default). Give it a dev login first:
#   psql ... -c "ALTER ROLE postwave_ops LOGIN PASSWORD 'postwave_ops_dev'"
# Leave unset to run without the ops console (dev only; production boots
# refuse to start without it).
OPS_DATABASE_URL=postgres://postwave_ops:postwave_ops_dev@localhost:5432/postwave?sslmode=disable

# Ops push & digest — all optional locally (unset = channel off, board still
# works). For local testing any loopback sink that answers 200 "ok" works as
# a fake Slack webhook, e.g. OPS_SLACK_WEBHOOK_URL=http://localhost:9999/ok.
OPS_SLACK_WEBHOOK_URL=                                  # LOCAL_DEFAULT (off)
OPS_ALERT_EMAIL=                                        # LOCAL_DEFAULT (off)
OPS_DIGEST_HOUR=8                                       # LOCAL_DEFAULT
OPS_TZ=UTC                                              # LOCAL_DEFAULT

# Internal microservices (deliverability, voice, automation, migration).
# Defaults match the docker-compose ports. If you don't run those services
# locally the API still boots — the features that need them just return
# `service_unavailable`.
# PORT COLLISION WARNING. Expo's dev server (apps/mobile) also defaults to
# 8081, and Metro answers 200 with an HTML app shell for EVERY path. So when
# both are running you do NOT get `service_unavailable` as described above —
# the API receives `200 text/html` where it expects JSON, which is the SPA
# fallback shape that reads as a successful response. Readiness will not catch
# it: it validates that this URL is configured, not that anything answers on
# it. Start Metro on another port (`expo start --port 8088`) or point this
# elsewhere before concluding that migrations are broken.
MIGRATION_SERVICE_URL=http://localhost:8081
DELIVERABILITY_SERVICE_URL=http://localhost:8082
VOICE_SERVICE_URL=http://localhost:8083
AUTOMATION_SERVICE_URL=http://localhost:8084
POSTWAVE_INTERNAL_API_TOKEN=  # LOCAL_DEFAULT

# Where the public surfaces live (used for OAuth callback URLs, archive
# links, magic-link redirects, etc.).
PUBLIC_BASE_URL=http://localhost:3000
POSTWAVE_PUBLIC_BASE_URL=http://localhost:3000
ARCHIVE_PUBLIC_BASE_URL=http://localhost:3000/archive

# Read-only customer audit portal. Build the SPA first with
# `pnpm --filter postwave-audit-portal build`; links carry a one-time
# bootstrap only in the URL fragment and exchange it for an HttpOnly cookie.
POSTWAVE_PORTAL_ORIGIN=http://localhost:8080
POSTWAVE_PORTAL_JWT_SECRET=
POSTWAVE_PORTAL_SPA_DIR=../audit-portal/dist
POSTWAVE_PORTAL_FRAME_ANCESTORS='self'

# ─── Native auth (required for SignUp / SignIn to work locally) ────────────
# Generate ONCE per workspace. If empty the API runs in a "no native auth"
# mode that's only useful if you're testing via API key.
POSTWAVE_AUTH_HMAC_PEPPER=  # GENERATE_ME (32-byte hex)
POSTWAVE_CONSENT_CURSOR_SIGNING_KEY=  # GENERATE_ME (dedicated >=32-byte key; never reuse another pepper/key)
POSTWAVE_PII_FINGERPRINT_PEPPER=  # GENERATE_ME (dedicated >=32-byte key; never reuse auth/API-key peppers)
POSTWAVE_PII_FINGERPRINT_KEY_VERSION=v1                 # increment whenever the fingerprint pepper rotates
POSTWAVE_MAILER=                                        # leave empty → dev mailer (writes to disk)
POSTWAVE_DEV_MAIL_SPOOL=/tmp/postwave-dev-mail          # where the dev mailer drops messages
POSTWAVE_AUTH_FROM_ADDRESS=noreply@postwave.local       # LOCAL_DEFAULT
POSTWAVE_COOKIE_DOMAIN=localhost                        # LOCAL_DEFAULT

# ─── Google OAuth (optional) ────────────────────────────────────────────────
# Desktop probes `/api/v1/auth/oauth/google/start` before showing its button.
# Set all three values together before exposing Google sign-in on web.
POSTWAVE_OAUTH_GOOGLE_CLIENT_ID=  # PROVIDE_ME (Google OAuth console)
POSTWAVE_OAUTH_GOOGLE_CLIENT_SECRET=  # PROVIDE_ME
POSTWAVE_OAUTH_REDIRECT_BASE=http://localhost:8080      # LOCAL_DEFAULT

# ─── Sending-token encryption (KEKs) ───────────────────────────────────────
# 32-byte values that wrap per-tenant sending credentials. Generate ONCE
# per workspace and never rotate without a re-encryption pass.
POSTWAVE_SENDING_KEK=                                   # GENERATE_ME (openssl rand -base64 32)
POSTWAVE_MIGRATION_SESSION_KEK=                         # GENERATE_ME (openssl rand -base64 32)
ARCHIVE_VIEWS_SALT=                                     # GENERATE_ME (16-byte hex)
DKIM_ROOT_DOMAIN=mail.postwave.local                    # LOCAL_DEFAULT

# Where to put on-disk data (uploads, dev-mailer spool, sqlite caches).
POSTWAVE_DATA_DIR=./.data                               # LOCAL_DEFAULT

# ─── CORS / CSRF allow-list ────────────────────────────────────────────────
# Doubles as the CSRF Origin allow-list (see internal/middleware/origin_csrf.go).
# Add any non-default ports you actually use; the desktop runs on 1420 by default.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:1420

# Runtime safety toggles — keep 0 in local. Set to 1 only when explicitly
# rehearsing an integration path you can't otherwise reach.
POSTWAVE_TRUST_FORWARDED_IP_HEADERS=0
POSTWAVE_TRUSTED_PROXY_CIDRS=
# Local API listeners normally receive browser TCP connections directly.
POSTWAVE_DIRECT_CLIENT_CONNECTIONS=1
POSTWAVE_DEV_TENANT_SLUG_HEADER=0
POSTWAVE_DEV_ADMIN_ROLE_HEADER=0
POSTWAVE_DEV_LISTMONK_WEBHOOK_BYPASS=0
POSTWAVE_DEV_SHOPIFY_WEBHOOK_BYPASS=0
# Explicit compatibility drill only; canonical inbound senders use v2.
POSTWAVE_ALLOW_LEGACY_INBOUND_SIGNATURE_V1=0
POSTWAVE_LEGACY_INBOUND_SIGNATURE_V1_EXPIRES_AT=
# Ops console only: skip the session+TOTP operator resolution and act as this
# email (the platform_operators row + IP allowlist still apply). Leave empty.
POSTWAVE_DEV_OPS_OPERATOR_EMAIL=
POSTWAVE_ALLOW_MEMORY_FALLBACK=0
POSTWAVE_ALLOW_UNSIGNED_SMS_WEBHOOKS=0

# ─── Email-sending transports (Postmark / SES / Mailgun) ───────────────────
# Leave the tokens empty in local and rely on POSTWAVE_DEV_MAIL_SPOOL.
# When you want to actually send to your own inbox: fill one provider in.
POSTMARK_ACCOUNT_TOKEN=  # PROVIDE_ME (postmark.com account)
POSTMARK_TRANSACTIONAL_TOKEN=  # PROVIDE_ME (postmark server token)
POSTMARK_BASE_URL=https://api.postmarkapp.com
AWS_SES_REGION=                                         # PROVIDE_ME (e.g. us-east-1) — separate from AWS_REGION below
POSTWAVE_SES_CONFIGURATION_SET=
POSTWAVE_SES_TOPIC_ARNS=
POSTWAVE_POSTMARK_HMAC_SECRET=  # GENERATE_ME if using Postmark inbound
POSTWAVE_POSTMARK_WEBHOOK_TOKEN=  # GENERATE_ME if using Postmark inbound
POSTWAVE_MAILGUN_WEBHOOK_KEY=  # PROVIDE_ME if using Mailgun inbound
POSTWAVE_SENDGRID_HMAC_SECRET=  # PROVIDE_ME if using SendGrid inbound
POSTWAVE_SENDGRID_WEBHOOK_TOKEN=  # GENERATE_ME for SendGrid deliverability receiver
POSTWAVE_RESEND_WEBHOOK_TOKEN=  # GENERATE_ME for Resend deliverability receiver
POSTWAVE_SPARKPOST_WEBHOOK_TOKEN=  # GENERATE_ME for SparkPost deliverability receiver
POSTWAVE_MAILERSEND_WEBHOOK_TOKEN=  # GENERATE_ME for MailerSend deliverability receiver
POSTWAVE_REFERRAL_COOKIE_SECRET=  # GENERATE_ME; >=32 bytes required in production; internal-token fallback is local-only
POSTWAVE_REFERRAL_FROM_EMAIL=                           # e.g. "Referrals <rewards@example.com>"
REFERRAL_SHARE_BASE_URL=                                # e.g. https://refer.example.com/api/public

# Zero-copy credentials are tenant-bound JSON secrets. For tenant
# 00000000-0000-0000-0000-000000000001 and credentials_ref "acme", local env
# resolution reads POSTWAVE_TENANTS_00000000_0000_0000_0000_000000000001_WAREHOUSE_READ_ONLY_ACME.
# The JSON must include "read_only": true and a DSN/token or provider fields;
# use a database principal that has SELECT-only grants.
# POSTWAVE_TENANTS_00000000_0000_0000_0000_000000000001_WAREHOUSE_READ_ONLY_ACME='{"read_only":true,"dsn":"postgres://...?..."}'

# ─── AWS credentials (OPTIONAL — skip entirely for local dev) ──────────────
#
# The API does NOT require AWS to boot. Every AWS-backed feature has a
# graceful local fallback:
#
#   KMS envelope encryption  →  static POSTWAVE_SENDING_KEK (above)
#   S3 file uploads          →  local filesystem under POSTWAVE_DATA_DIR
#   Secrets Manager          →  env vars (the normal local mode)
#   SES outbound mail        →  Postmark or the dev mailer
#
# If you want to opt INTO an AWS feature locally (e.g. test the KMS path,
# rehearse an S3-backed upload), fill the AWS_ACCESS_KEY_ID + _SECRET_ACCESS_KEY
# pair (or use AWS_PROFILE), set AWS_REGION, AND set the POSTWAVE_* toggle for
# the specific feature. Leaving any of the three unset keeps that feature on
# the local fallback path.
#
# Standard AWS SDK credential chain — picks up from env, then ~/.aws/credentials,
# then EC2 IMDS, then SSO. Setting AWS_PROFILE is usually cleaner than pasting
# the access key here.
AWS_ACCESS_KEY_ID=  # PROVIDE_ME only if opting into KMS/S3/SES
AWS_SECRET_ACCESS_KEY=  # PROVIDE_ME only if opting into KMS/S3/SES
AWS_SESSION_TOKEN=  # PROVIDE_ME only if your creds are temporary (SSO/STS)
AWS_PROFILE=                                            # PROVIDE_ME if using ~/.aws/credentials (cleaner than the pair above)
AWS_REGION=                                             # PROVIDE_ME if any POSTWAVE_* AWS toggle below is set

# Moosewave-specific AWS toggles. ALL three off by default — the app boots
# fine without them and uses the local fallback for each feature.
POSTWAVE_KMS_KEY_ID=                                    # PROVIDE_ME to enable KMS envelope encryption (needs AWS_REGION too)
POSTWAVE_UPLOADS_BUCKET=                                # PROVIDE_ME to push form uploads to S3 (needs AWS_REGION + S3 KMS key)
POSTWAVE_ASSETS_BUCKET=                                 # PROVIDE_ME to push library assets to S3 (normally the uploads bucket)
POSTWAVE_EXPORTS_BUCKET=                                # PROVIDE_ME to store tenant export ZIPs in a separate private, non-CDN bucket
POSTWAVE_S3_KMS_KEY_ID=                                 # PROVIDE_ME with the dedicated uploads/assets/tenant-export CMK ARN
POSTWAVE_FORM_UPLOAD_CLAMAV_ADDR=                       # OPTIONAL local clamd host:port; without it uploads remain quarantined
POSTWAVE_FORM_UPLOAD_TENANT_QUOTA_BYTES=1073741824      # LOCAL_DEFAULT 1 GiB reserved+clean bytes per tenant
POSTWAVE_FORM_UPLOAD_PENDING_LIMIT=100                  # LOCAL_DEFAULT max pending/quarantined reservations per tenant
POSTWAVE_SECRETS_BACKEND=                               # set to "aws" to read tenant secrets from Secrets Manager (needs AWS_REGION too)
AWS_KMS_TEST_KEY_ID=                                    # OPTIONAL — only used by `go test ./internal/crypto`

# Suppress-list & abuse hardening.
POSTWAVE_BLOCKLIST_AUTO_SUPPRESS=1                      # LOCAL_DEFAULT
POSTWAVE_DEFAULT_FROM_EMAIL=hello@postwave.local        # LOCAL_DEFAULT
# Campaign delivery interlocks. Both default false; sandbox lifecycle requests
# remain available when the simulator is wired. Enable live dispatch only in a
# deliberately provisioned environment. The scheduler flag is reserved and
# cannot start the legacy worker until durable claim recovery is compile-time
# qualified in a future release.
POSTWAVE_ENABLE_CAMPAIGN_LIVE_DISPATCH=false
POSTWAVE_ENABLE_CAMPAIGN_SCHEDULER=false
POSTWAVE_REPORT_FROM_EMAIL=reports@postwave.local       # LOCAL_DEFAULT
APPROVAL_FROM_EMAIL=approvals@postwave.local            # LOCAL_DEFAULT

# Replies inbound (only matters if you want reply-to threading locally).
POSTWAVE_REPLIES_ENVELOPE_DOMAIN=replies.postwave.local
POSTWAVE_REPLIES_VERP_SECRET=  # GENERATE_ME if using replies inbound
POSTWAVE_REPLIES_POSTMARK_SECRET=  # GENERATE_ME if Postmark
POSTWAVE_REPLIES_MAILGUN_SIGNING_KEY=  # GENERATE_ME if Mailgun
POSTWAVE_REPLIES_SES_SHARED_SECRET=  # GENERATE_ME if SES

# Public forms + recaptcha (optional locally).
FORMS_PUBLIC_HOST=http://localhost:3000
RECAPTCHA_SECRET=  # PROVIDE_ME if testing recaptcha
RECAPTCHA_SITE_KEY=  # matching public reCAPTCHA v2 checkbox site key

# ─── Commerce integrations (all optional) ──────────────────────────────────

# Stripe billing — required only if you want the billing/subscription UI live.
STRIPE_WEBHOOK_SECRET=  # PROVIDE_ME from `stripe listen`
STRIPE_SECRET_KEY=  # PROVIDE_ME (sk_test_… in dev)
STRIPE_PRICE_LTD=                                       # PROVIDE_ME (price_… one-time)
STRIPE_PRICE_SENDING=                                   # PROVIDE_ME (price_… recurring)
STRIPE_PRICE_PRO=                                       # PROVIDE_ME (price_… recurring)
PRICING_CANCEL_URL=http://localhost:3000/pricing

# Shopify — required only if you want the commerce panels live.
SHOPIFY_CLIENT_ID=  # PROVIDE_ME
SHOPIFY_CLIENT_SECRET=  # PROVIDE_ME
SHOPIFY_SCOPES=read_customers,read_products,read_orders,read_all_orders
SHOPIFY_OAUTH_REDIRECT_URL=                             # http://localhost:8080/api/v1/shopify/oauth/callback
SHOPIFY_STATE_SECRET=  # GENERATE_ME
SHOPIFY_WEBHOOK_SECRET=  # GENERATE_ME

# ─── Migration adapters (only if testing Klaviyo / Mailchimp / ConvertKit imports) ─
MAILCHIMP_CLIENT_ID=  # PROVIDE_ME
MAILCHIMP_CLIENT_SECRET=  # PROVIDE_ME
CONVERTKIT_CLIENT_ID=  # PROVIDE_ME
CONVERTKIT_CLIENT_SECRET=  # PROVIDE_ME

# Optional Klaviyo migration live validation. KLAVIYO_ACCOUNT_ID is required
# only when the private key exposes multiple accounts. Any KLAVIYO_LIVE_* flag
# fails closed without KLAVIYO_API_KEY and durable live-artifact configuration.
KLAVIYO_API_KEY=  # PROVIDE_ME — dedicated private migration key
KLAVIYO_ACCOUNT_ID=                                     # PROVIDE_ME for multi-account keys
KLAVIYO_LIVE_DRY_RUN=0
KLAVIYO_LIVE_COMMIT=0
KLAVIYO_LIVE_ROLLBACK=0
KLAVIYO_LIVE_SOURCE_EVENTS=0
KLAVIYO_LIVE_SOURCE_EVENT_INTERVAL_SECONDS=900
KLAVIYO_LIVE_DELTA_IMPORT=0
KLAVIYO_LIVE_SHADOW_CHECK=0
KLAVIYO_LIVE_ROLLBACK_REHEARSAL=0
KLAVIYO_LIVE_MANUAL_REVIEW_SIGNOFF=0
KLAVIYO_LIVE_MANUAL_REVIEW_EVIDENCE_REF=                # non-secret ticket/artifact reference
KLAVIYO_LIVE_CREDENTIAL_CLEANUP_REVIEW=0
KLAVIYO_LIVE_CREDENTIAL_CLEANUP_EVIDENCE_REF=           # non-secret key rotation/revocation proof
KLAVIYO_LIVE_FAIL_ON_DISCOVERY_WARNINGS=0
KLAVIYO_LIVE_FAIL_ON_SOURCE_ARCHIVE_WARNINGS=0
KLAVIYO_LIVE_PILOT_ACCEPTANCE=0

# ─── Social publishing + ads (Meta + Google Ads) ───────────────────────────
# Empty values keep the social/ads UI visible but fail-closed.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v24.0
META_PAGE_ID=                                           # PROVIDE_ME
META_PAGE_ACCESS_TOKEN=  # PROVIDE_ME
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=                     # PROVIDE_ME
META_AD_ACCOUNT_ID=                                     # PROVIDE_ME
META_ADS_ACCESS_TOKEN=  # PROVIDE_ME
GOOGLE_ADS_API_BASE_URL=https://googleads.googleapis.com
GOOGLE_ADS_API_VERSION=v24
GOOGLE_ADS_DEVELOPER_TOKEN=  # PROVIDE_ME
GOOGLE_ADS_CLIENT_ID=  # PROVIDE_ME
GOOGLE_ADS_CLIENT_SECRET=  # PROVIDE_ME
GOOGLE_ADS_REFRESH_TOKEN=  # PROVIDE_ME
GOOGLE_ADS_LOGIN_CUSTOMER_ID=                           # PROVIDE_ME
GOOGLE_ADS_CUSTOMER_ID=                                 # PROVIDE_ME
GOOGLE_OAUTH_TOKEN_URL=https://www.googleapis.com/oauth2/v3/token

# ─── Deliverability sidecar (optional in local) ────────────────────────────
GEMINI_API_KEY=  # PROVIDE_ME (Google AI Studio)
HCTI_USER_ID=                                           # PROVIDE_ME (htmlcsstoimage.com)
HCTI_API_KEY=  # PROVIDE_ME
SEEDLIST_CONNECTOR=imap
SEEDLIST_IMAP_FOLDERS=INBOX,Promotions,Updates,Social,Spam,Junk,Junk Email,Bulk Mail
SEEDLIST_IMAP_MARK_SEEN=false
DMARC_IMAP_INTERVAL_SECONDS=300

# ─── SMS providers (all optional in local) ─────────────────────────────────
SMS_DEFAULT_PROVIDER=twilio
TWILIO_ACCOUNT_SID=                                     # PROVIDE_ME
TWILIO_AUTH_TOKEN=  # PROVIDE_ME
TWILIO_MESSAGING_SERVICE_SID=                           # PROVIDE_ME
TWILIO_FROM_NUMBER=                                     # PROVIDE_ME
TWILIO_API_BASE_URL=https://api.twilio.com
TWILIO_MESSAGING_API_BASE_URL=https://messaging.twilio.com
# Telnyx — uncomment if testing Telnyx
# TELNYX_API_KEY=
# TELNYX_FROM_NUMBER=
# TELNYX_PUBLIC_KEY=
# Bandwidth — uncomment if testing Bandwidth
# BANDWIDTH_ACCOUNT_ID=
# BANDWIDTH_API_USERNAME=
# BANDWIDTH_API_PASSWORD=

# ─── Telemetry (PostHog + Sentry) ──────────────────────────────────────────
# Empty = dormant. Set the project key (phc_...) if you want events flowing
# from your local — only do this in a dev project, not your prod one.
POSTHOG_API_KEY=  # PROVIDE_ME if you want server events
POSTHOG_API_HOST=https://eu.posthog.com

# ─── Compliance / legal posture (cosmetic locally) ─────────────────────────
POSTWAVE_LEGAL_ENTITY=Moosewave Dev Workspace
POSTWAVE_LEGAL_ADDRESS=Localhost
POSTWAVE_DPA_VERSION=2026-05
POSTWAVE_EU_REPR_NAME=
POSTWAVE_EU_REPR_ADDRESS=
# Must match tenants.data_region's supported-region enum even in development.
POSTWAVE_DEPLOYMENT_REGION=us-east-1
POSTWAVE_RELEASE=dev
# Empty keeps the site non-indexable and draft legal/comparison routes closed.
# Set approved:<release-record-reference> only after formal publication review.
POSTWAVE_PUBLIC_RELEASE_APPROVAL=


# ────────────────────────────────────────────────────────────────────────────
# Section 2 — apps/web  (Next.js, default port :3000)
# ────────────────────────────────────────────────────────────────────────────

# Server-side (Next API routes proxy these to the Go gateway).
API_URL=http://localhost:8080
POSTWAVE_API_URL=http://localhost:8080
POSTWAVE_API_KEY=  # PROVIDE_ME — local API key minted from your dev tenant

# Browser-exposed (NEXT_PUBLIC_*). Anything here is visible in DevTools.
NEXT_PUBLIC_API_URL=                                    # leave empty in dev to use Next's /api rewrite
NEXT_PUBLIC_LISTMONK_URL=http://localhost:9000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:3001/docs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FORMS_ORIGIN=http://localhost:3000

# Demo / mock mode for the Mailchimp-parity compatibility pages. Turn on
# only in a disposable tenant — these will create demo parity records.
NEXT_PUBLIC_USE_MOCKS=0
NEXT_PUBLIC_ENABLE_COMPAT_DEMO_ACTIONS=0
NEXT_PUBLIC_ALLOW_PRODUCTION_DEMO_ACTIONS=0

# Tenant slug used for /api/v1/{slug}/... when the user isn't routed via
# a custom domain. Defaults to "dev" in code.
NEXT_PUBLIC_POSTWAVE_TENANT_SLUG=dev
NEXT_PUBLIC_TENANT_SLUG=dev

# Telemetry — see Section 1 about PostHog. Use phc_... (project), not phx_...
NEXT_PUBLIC_POSTHOG_KEY=  # PROVIDE_ME if you want browser events
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=/api/internal/web-vitals
SENTRY_DSN=  # PROVIDE_ME if you want Sentry locally

# Mobile + universal-link plumbing (only matters if you're testing iOS/Android
# deep links from the web app).
POSTWAVE_ANDROID_PACKAGE_NAME=app.postwave.android
POSTWAVE_ANDROID_SHA256_CERT_FINGERPRINTS=
POSTWAVE_APPLE_TEAM_ID=

# DEV-ONLY auth shortcut. Setting this to a value lets API routes accept
# requests without a session — DO NOT set in any deployed env.
POSTWAVE_AUTH_BYPASS=                                   # leave empty unless debugging


# ────────────────────────────────────────────────────────────────────────────
# Section 3 — apps/desktop  (Vite + Tauri, default port :1420)
# ────────────────────────────────────────────────────────────────────────────

# Where the desktop talks to the API. localhost is fine when running on
# the same machine; for shared dev tunnels use the public URL.
VITE_API_URL=http://localhost:8080

# Build-time profile (informational — surfaced in About + telemetry).
VITE_BUILD_PROFILE=dev
VITE_POSTWAVE_RELEASE=dev

# Browser links surfaced from the desktop (Help menu, footers).
VITE_DASHBOARD_URL=http://localhost:3000
VITE_SUPPORT_URL=https://moosewave.com/support
VITE_PRIVACY_POLICY_URL=https://moosewave.com/privacy
VITE_TERMS_URL=https://moosewave.com/terms
VITE_ACCOUNT_DELETION_URL=https://moosewave.com/account/delete

# Telemetry — phc_... project key + your PostHog host. Empty = dormant.
VITE_POSTHOG_KEY=  # PROVIDE_ME if you want desktop events
VITE_POSTHOG_HOST=https://eu.posthog.com
VITE_SENTRY_DSN_DESKTOP=                                # PROVIDE_ME if you want Sentry locally


# =============================================================================
# After filling in the above, verify nothing's still GENERATE_ME or PROVIDE_ME
# that you actually need:
#
#   grep -nE "GENERATE_ME|PROVIDE_ME" .env.local
#
# Only the items you've explicitly opted out of should remain (e.g. you
# might not want Stripe billing on locally — those PROVIDE_MEs can stay).
#
# Quick sanity check — the API should boot with just the LOCAL_DEFAULT +
# GENERATE_ME values filled. Everything else is feature-gated and silently
# off until you provide credentials.
# =============================================================================
