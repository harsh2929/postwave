{
  "name": "@postwave/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "node ../scripts/refuse-archived-docs-build.mjs build",
    "build:archive-preview": "POSTWAVE_ARCHIVED_DOCS_PREVIEW=1 next build",
    "start": "node ../scripts/refuse-archived-docs-build.mjs start",
    "start:archive-preview": "POSTWAVE_ARCHIVED_DOCS_PREVIEW=1 next start -p 3001",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.24",
    "nextra": "^3.0.0",
    "nextra-theme-docs": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.18",
    "typescript": "^5.4.0"
  }
}
