name: visual-regression

# Visual regression for the desktop design-system primitives, driven
# by Storybook. Builds the static Storybook bundle, serves it locally,
# and runs Playwright tests that diff each story against a committed
# baseline under apps/desktop/tests/storybook/stories.spec.ts-snapshots/.
#
# BASELINE WORKFLOW
#   On a clean checkout the first run will fail with "no baseline"
#   errors for every story. Generate baselines locally:
#     cd apps/desktop && pnpm build-storybook && pnpm test:stories:update
#   Then commit the resulting *.png files. Subsequent CI runs will
#   diff against those baselines.
#
# Why a separate workflow (not folded into playwright.yml):
#   The existing playwright.yml boots the full docker-compose stack
#   (api + postgres + redis + …) and screenshots the running app.
#   Storybook doesn't need any of that — pure static bundle, no
#   network, no migrations. Splitting saves ~5 minutes per PR.

# This workflow does NOT consume untrusted PR-body/title/comment fields
# in run: blocks.

on:
  pull_request:
    paths:
      - 'apps/desktop/src/stories/**'
      - 'apps/desktop/src/components/**'
      - 'apps/desktop/src/styles*.css'
      - 'apps/desktop/.storybook/**'
      - 'apps/desktop/tests/storybook/**'
      - 'apps/desktop/playwright-storybook.config.ts'
      - 'apps/desktop/package.json'
      - '.github/workflows/visual-regression.yml'
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: visual-regression-${{ github.ref }}
  cancel-in-progress: true

jobs:
  storybook-visual:
    name: Storybook visual regression
    # Snapshot rasterization is platform-specific. Keep the gate on the same
    # pinned macOS image used to create and review the committed Darwin
    # baselines instead of silently asking Linux for a different file set.
    runs-on: macos-14
    timeout-minutes: 20
    defaults:
      run:
        working-directory: apps/desktop
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Set up Node
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '20.19.5'

      - name: Set up pnpm
        uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1
        with:
          version: 9.12.0
          run_install: false

      - name: Install workspace deps
        working-directory: .
        run: pnpm install --frozen-lockfile

      - name: Install Playwright browser
        run: pnpm exec playwright install chromium

      - name: Build Storybook
        run: pnpm build-storybook

      - name: Run Storybook visual regression
        run: pnpm test:stories
        env:
          CI: '1'

      - name: Upload Playwright report
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: storybook-visual-report
          path: apps/desktop/playwright-report
          retention-days: 14

      - name: Upload diffs on failure
        if: failure()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: storybook-visual-diffs
          path: apps/desktop/test-results
          retention-days: 14
