name: OpenAPI Spec Check

# Keeps packages/openapi/openapi.{yaml,json} in lock-step with the routes
# wired up in apps/api/main.go and the per-package MountRoutes funcs.
#
# Mechanism:
#   1. Check that static gateway routes are present in the YAML contract.
#   2. Check required operation metadata and both generated mirrors.
#   3. Check gateway/sidecar route parity and first-party SDK coverage.
#
# Hard rule: NO untrusted github.event.* values are interpolated into shell
# commands. Every dynamic value must go through env: blocks.

on:
  pull_request:
    paths:
      - "apps/api/**"
      - "services/migration/**"
      - "packages/openapi/**"
      - "packages/sdk-ts/src/resources/migrations.ts"
      - "apps/web/src/lib/migration-api.ts"
      - "package.json"
      - "pnpm-lock.yaml"
      - "scripts/check-route-parity.mjs"
      - "scripts/check-route-reachability-coverage.mjs"
      - "scripts/check-openapi-contract-quality.mjs"
      - "scripts/generate-route-capabilities.mjs"
      - "scripts/check-sdk-parity.mjs"
      - "scripts/check-sdk-surface-drift.mjs"
      - "scripts/check-cutover-evidence-contract.mjs"
      - ".github/workflows/openapi-check.yml"
  push:
    branches:
      - main
    paths:
      - "apps/api/**"
      - "services/migration/**"
      - "packages/openapi/**"
      - "packages/sdk-ts/src/resources/migrations.ts"
      - "apps/web/src/lib/migration-api.ts"
      - "package.json"
      - "pnpm-lock.yaml"
      - "scripts/check-route-parity.mjs"
      - "scripts/check-route-reachability-coverage.mjs"
      - "scripts/check-openapi-contract-quality.mjs"
      - "scripts/generate-route-capabilities.mjs"
      - "scripts/check-sdk-parity.mjs"
      - "scripts/check-sdk-surface-drift.mjs"
      - "scripts/check-cutover-evidence-contract.mjs"

permissions:
  contents: read

concurrency:
  group: openapi-check-${{ github.ref }}
  cancel-in-progress: true

jobs:
  spec-up-to-date:
    name: OpenAPI spec - extracted routes match committed spec
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
        with:
          submodules: false

      - name: Setup Go
        uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff
        with:
          go-version: "1.26.8"
          cache: true

      - name: Setup pnpm
        uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1
        with:
          version: 9.12.0

      - name: Setup Node
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 20.19.5
          cache: pnpm

      - name: Install locked dependencies
        run: pnpm install --frozen-lockfile

      - name: Gateway route extraction drift check
        run: |
          go test ./packages/openapi/scripts/regenerate.go ./packages/openapi/scripts/regenerate_test.go
          go run ./packages/openapi/scripts/regenerate.go -check

      - name: Go→OpenAPI schema generator drift check
        run: |
          go test ./packages/openapi/scripts/gen-go-schemas.go ./packages/openapi/scripts/gen-go-schemas_test.go
          # MERGE-AWARE. Plain `-check` only compares the Go structs to
          # generated/go-schemas.yaml — a file no client reads. Adding a field
          # to an allow-listed struct failed that check, regenerating made it
          # pass, and the SERVED spec still published a closed schema without
          # the field, so a real response would fail its own published
          # contract. This also compares the spec's copy.
          go run ./packages/openapi/scripts/gen-go-schemas.go -check -merge TransactionalEmailRecord

      - name: Operation metadata drift check
        run: node packages/openapi/scripts/complete-operation-metadata.mjs --check

      - name: OpenAPI JSON mirror drift check
        run: python3 packages/openapi/scripts/yaml-to-json.py --check

      - name: OpenAPI client-contract quality ratchet
        run: |
          node scripts/check-openapi-contract-quality.mjs --self-test
          node scripts/check-openapi-contract-quality.mjs

      - name: Gateway and migration-sidecar route parity
        run: |
          node --test scripts/lib/route-reachability.test.mjs
          node scripts/check-route-reachability-coverage.mjs --self-test
          node scripts/check-route-reachability-coverage.mjs
          node scripts/check-route-parity.mjs
          node scripts/generate-route-capabilities.mjs --check

      - name: First-party SDK parity
        run: |
          node scripts/check-sdk-parity.mjs
          node scripts/check-cutover-evidence-contract.mjs
