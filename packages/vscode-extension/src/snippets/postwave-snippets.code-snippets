{
  "Moosewave: Welcome email": {
    "prefix": "pw-welcome",
    "scope": "typescriptreact,javascriptreact",
    "description": "Starter Welcome email using @postwave/email-react primitives.",
    "body": [
      "// SPDX-License-Identifier: MIT",
      "import {",
      "  Email,",
      "  Section,",
      "  Column,",
      "  Heading,",
      "  Text,",
      "  Button,",
      "  Footer,",
      "} from \"@postwave/email-react\";",
      "",
      "export default function Welcome() {",
      "  return (",
      "    <Email preview=\"${1:Welcome to ${2:Acme}}\">",
      "      <Section>",
      "        <Column>",
      "          <Heading>${3:Hi {{first_name}},}</Heading>",
      "          <Text>${4:Thanks for joining ${2}. Here's what to do next.}</Text>",
      "          <Button href=\"${5:https://example.com/get-started}\">${6:Get started}</Button>",
      "        </Column>",
      "      </Section>",
      "      <Footer />",
      "    </Email>",
      "  );",
      "}"
    ]
  },
  "Moosewave: Newsletter": {
    "prefix": "pw-newsletter",
    "scope": "typescriptreact,javascriptreact",
    "description": "Starter Newsletter email with hero, body, and link list.",
    "body": [
      "// SPDX-License-Identifier: MIT",
      "import {",
      "  Email,",
      "  Section,",
      "  Column,",
      "  Heading,",
      "  Text,",
      "  Image,",
      "  Link,",
      "  Divider,",
      "  Footer,",
      "} from \"@postwave/email-react\";",
      "",
      "export default function Newsletter() {",
      "  return (",
      "    <Email preview=\"${1:This week at ${2:Acme}}\">",
      "      <Section>",
      "        <Column>",
      "          <Image src=\"${3:https://example.com/hero.png}\" alt=\"${4:Hero}\" />",
      "          <Heading>${5:This week's update}</Heading>",
      "          <Text>${6:A short summary of what's new.}</Text>",
      "          <Divider />",
      "          <Text><Link href=\"${7:https://example.com/post-1}\">${8:Read post one}</Link></Text>",
      "          <Text><Link href=\"${9:https://example.com/post-2}\">${10:Read post two}</Link></Text>",
      "        </Column>",
      "      </Section>",
      "      <Footer />",
      "    </Email>",
      "  );",
      "}"
    ]
  },
  "Moosewave: Promo": {
    "prefix": "pw-promo",
    "scope": "typescriptreact,javascriptreact",
    "description": "Starter Promo email with offer + CTA.",
    "body": [
      "// SPDX-License-Identifier: MIT",
      "import {",
      "  Email,",
      "  Section,",
      "  Column,",
      "  Heading,",
      "  Text,",
      "  Button,",
      "  Spacer,",
      "  Footer,",
      "} from \"@postwave/email-react\";",
      "",
      "export default function Promo() {",
      "  return (",
      "    <Email preview=\"${1:${2:25}% off this week only}\">",
      "      <Section>",
      "        <Column>",
      "          <Heading>${3:${2}% off everything}</Heading>",
      "          <Text>${4:Use code ${5:WELCOME25} at checkout. Ends ${6:Friday}.}</Text>",
      "          <Spacer height=\"16px\" />",
      "          <Button href=\"${7:https://example.com/shop}\">${8:Shop the sale}</Button>",
      "        </Column>",
      "      </Section>",
      "      <Footer />",
      "    </Email>",
      "  );",
      "}"
    ]
  },
  "Moosewave: Transactional": {
    "prefix": "pw-transactional",
    "scope": "typescriptreact,javascriptreact",
    "description": "Starter Transactional email (receipt / confirmation).",
    "body": [
      "// SPDX-License-Identifier: MIT",
      "import {",
      "  Email,",
      "  Section,",
      "  Column,",
      "  Heading,",
      "  Text,",
      "  Button,",
      "  Divider,",
      "  Footer,",
      "} from \"@postwave/email-react\";",
      "",
      "export default function Transactional() {",
      "  return (",
      "    <Email preview=\"${1:Your ${2:order} confirmation}\">",
      "      <Section>",
      "        <Column>",
      "          <Heading>${3:Thanks for your ${2}}</Heading>",
      "          <Text>${4:Order #{{order_id}} — confirmed on {{order_date}}.}</Text>",
      "          <Divider />",
      "          <Text>${5:Total: {{order_total}}}</Text>",
      "          <Button href=\"${6:https://example.com/order/{{order_id}}}\">${7:View order}</Button>",
      "        </Column>",
      "      </Section>",
      "      <Footer />",
      "    </Email>",
      "  );",
      "}"
    ]
  }
}
