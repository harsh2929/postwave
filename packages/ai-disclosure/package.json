{
  "name": "@postwave/ai-disclosure",
  "version": "0.1.0",
  "type": "module",
  "description": "Single source of truth for Moosewave's EU AI Act Article 50 disclosure text + machine-readable generation marker, shared across every client (web/desktop/mobile) and mirrored by the Go gateway.",
  "keywords": ["postwave", "ai-act", "compliance", "disclosure"],
  "author": "Moosewave",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh2929/postwave.git",
    "directory": "packages/ai-disclosure"
  },
  "bugs": {
    "url": "https://github.com/harsh2929/postwave/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
