{
    "name": "postwave/postwave-php",
    "description": "Official PHP SDK for the Moosewave email + automation platform.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.2.35 || ~8.3.36 || ~8.4.27 || ~8.5.12",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Moosewave\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moosewave\\Tests\\": "tests/"
        }
    }
}
