{
  "name": "@postwave/nav",
  "version": "0.1.0",
  "type": "module",
  "description": "Single source of truth for Moosewave's primary navigation / information architecture — one typed manifest of every primary nav entry (canonical label, icon key, scope, per-surface route) consumed by web/desktop/mobile so the three surfaces stop hand-rolling divergent nav maps.",
  "keywords": ["postwave", "navigation", "information-architecture", "nav"],
  "author": "Moosewave",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh2929/postwave.git",
    "directory": "packages/nav"
  },
  "bugs": {
    "url": "https://github.com/harsh2929/postwave/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
