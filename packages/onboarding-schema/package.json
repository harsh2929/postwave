{
  "name": "@postwave/onboarding-schema",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared onboarding contract for every Moosewave client: the tour/checklist/empty-state/hint content schema, the /onboarding-progress client types, and onboarding analytics property shapes. One definition, three native renderers (web/desktop/mobile).",
  "keywords": ["postwave", "onboarding", "walkthrough", "tour", "schema"],
  "author": "Moosewave",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh2929/postwave.git",
    "directory": "packages/onboarding-schema"
  },
  "bugs": {
    "url": "https://github.com/harsh2929/postwave/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
