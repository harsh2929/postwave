{
  "name": "@postwave/telemetry",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared Moosewave telemetry contract: SDK-free Sentry PII/secret redaction (events + breadcrumbs), uniform opt-in consent default, and a canonical PostHog event taxonomy.",
  "keywords": ["postwave", "telemetry", "sentry", "posthog", "redaction", "consent"],
  "author": "Moosewave",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh2929/postwave.git",
    "directory": "packages/telemetry"
  },
  "bugs": { "url": "https://github.com/harsh2929/postwave/issues" },
  "publishConfig": { "access": "public" }
}
