{
  "name": "@postwave/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Release-held source candidate for Moosewave's private, single-tenant MCP REST adapter; not a hosted or production-qualified connector.",
  "keywords": [
    "postwave",
    "mcp",
    "model-context-protocol",
    "anthropic",
    "claude",
    "claude-code",
    "cursor",
    "agent",
    "agents",
    "ai",
    "email",
    "newsletter"
  ],
  "author": "Moosewave",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "postwave-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "homepage": "https://github.com/harsh2929/postwave/tree/main/packages/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh2929/postwave.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/harsh2929/postwave/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "verify:candidate": "node scripts/verify-candidate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@postwave/sdk": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
