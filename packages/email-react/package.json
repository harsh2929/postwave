{
  "name": "@postwave/email-react",
  "version": "0.1.0",
  "description": "JSX → MJML compiler for email components. Compose responsive, dark-mode-aware emails as React-style components and ship them through any ESP.",
  "keywords": [
    "postwave",
    "email",
    "mjml",
    "react",
    "jsx",
    "react-email",
    "newsletter",
    "transactional-email"
  ],
  "author": "Moosewave",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/harsh2929/postwave/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "postwave-email-render": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://docs.moosewave.com/email-react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh2929/postwave.git",
    "directory": "packages/email-react"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mjml": "5.4.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
