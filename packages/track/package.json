{
  "name": "@postwave/track",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser producer for Moosewave's first-party, cookieless event endpoint (POST /api/public/track/event).",
  "keywords": [
    "postwave",
    "analytics",
    "first-party",
    "events",
    "tracker"
  ],
  "author": "Moosewave",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh2929/postwave.git",
    "directory": "packages/track"
  },
  "bugs": {
    "url": "https://github.com/harsh2929/postwave/issues"
  }
}
