      "svgo@>=4.0.0 <4.1.0": "4.1.0",
      "turbo@<2.9.14": "2.9.14",
      "underscore@<=1.13.7": "1.13.8",
      "undici@<6.28.0": "6.28.0",
      "uuid@<14.0.0": "14.0.0",
      "vite@<8.0.16": "8.0.16",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
