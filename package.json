{
  "name": "postwave",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter='!@postwave/docs'",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "audit:workspace-quality": "node scripts/check-workspace-quality.mjs",
    "audit:brand": "node scripts/release/check-moosewave-brand.mjs",
    "audit:test-skip-honesty": "node scripts/check-test-skip-honesty.mjs --self-test && node scripts/check-test-skip-honesty.mjs",
    "audit:migration-numbering": "node scripts/check-migration-numbering.mjs --self-test && node scripts/check-migration-numbering.mjs",
    "audit:release-locks": "node scripts/check-managed-send-allowance.mjs && node scripts/check-commercial-usage-allowances.mjs && node scripts/check-release-lock-registry.mjs --self-test && node scripts/check-release-lock-registry.mjs",
    "audit:context-epoch": "node scripts/check-context-epoch-wiring.mjs --self-test && node scripts/check-context-epoch-wiring.mjs",
    "audit:audit-actor-vocabulary": "node scripts/check-audit-actor-vocabulary.mjs --self-test && node scripts/check-audit-actor-vocabulary.mjs",
    "audit:security-scan-coverage": "node scripts/check-security-scan-coverage.mjs",
    "test:security-scan-coverage": "node scripts/check-security-scan-coverage.mjs --self-test",
    "test:workspace-quality": "node scripts/check-workspace-quality.mjs --self-test",
    "test:npm-release-plan": "node --test scripts/release/npm-release-plan.test.mjs",
    "verify:npm-packages": "pnpm -r --filter './packages/**' --if-present run build && node scripts/release/verify-npm-package-set.mjs",
    "docs:contracts": "node scripts/check-documentation-contracts.mjs",
    "test:docs-contracts": "node scripts/check-documentation-contracts.mjs --self-test",
    "audit:distribution": "node scripts/check-distribution-hygiene.mjs",
    "test:smoke:local": "playwright test -c playwright.local.config.ts",
    "test:migrations:live": "node scripts/validate-live-migrations.mjs",
    "test:pilot:smoke": "node scripts/pilot-certification-smoke.mjs",
    "audit:js": "node scripts/audit-js.mjs",
    "test:audit-js": "node --test scripts/audit-js.test.mjs",
    "audit:prod": "node scripts/audit-production-readiness.mjs",
    "audit:claims": "pnpm audit:sms-release-claims && pnpm audit:helpdesk-release-claims && node scripts/check-public-claims.mjs",
    "audit:helpdesk-release-claims": "node --test scripts/lib/helpdesk-release-claims.test.mjs && node scripts/check-helpdesk-release-claims.mjs",
    "audit:sms-release-claims": "pnpm --filter '@postwave/mcp-server...' build && node --test scripts/lib/sms-release-claims.test.mjs && node scripts/check-sms-release-claims.mjs",
    "audit:observability": "node scripts/check-observability-contract.mjs",
    "audit:observability:collector": "bash scripts/check-observability-collector.sh",
    "audit:observability:collector:release": "POSTWAVE_COLLECTOR_SCAN=true bash scripts/check-observability-collector.sh",
    "audit:handoff": "node scripts/check-sensitive-handoff.mjs",
    "audit:platform": "node scripts/check-sensitive-handoff.mjs && node scripts/check-security-scan-coverage.mjs && node scripts/check-production-platform.mjs && node scripts/release/verify-aws-deployment-contracts.mjs",
    "audit:backup-dr": "bash scripts/check-backup-dr.sh",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "audit:openapi": "pnpm --filter @postwave/openapi sync-json:check && pnpm --filter @postwave/openapi codegen:check && pnpm audit:openapi-quality && pnpm audit:routes && pnpm audit:subscribers",
    "audit:openapi-quality": "node scripts/check-openapi-contract-quality.mjs",
    "test:openapi-quality": "node scripts/check-openapi-contract-quality.mjs --self-test",
    "openapi:codegen": "pnpm --filter @postwave/openapi codegen",
    "openapi:codegen:check": "pnpm --filter @postwave/openapi codegen:check",
    "audit:webhook-events": "node scripts/check-webhook-event-catalog.mjs --self-test && node scripts/check-webhook-event-catalog.mjs",
    "audit:routes": "node --test scripts/lib/route-reachability.test.mjs scripts/lib/route-contracts.test.mjs && node scripts/check-route-reachability-coverage.mjs --self-test && node scripts/check-route-reachability-coverage.mjs && node scripts/check-route-parity.mjs && node scripts/generate-route-capabilities.mjs --check",
    "audit:klaviyo": "node scripts/check-klaviyo-gap-alleviation.mjs",
    "audit:mailchimp": "node scripts/check-mailchimp-gap-alleviation.mjs",
    "audit:subscribers": "node scripts/check-subscriber-parity.mjs",
    "audit:tenant-abuse": "node scripts/check-tenant-abuse-hardening.mjs",
    "audit:sdk-tiers": "node scripts/check-sdk-tiers.mjs",
    "audit:sdk-parity": "node scripts/check-sdk-tiers.mjs && node scripts/check-sdk-surface-drift.mjs && node scripts/check-sdk-type-shapes.mjs --self-test && node scripts/check-sdk-type-shapes.mjs && pnpm --filter @postwave/sdk generate:operations:check && node scripts/check-sdk-parity.mjs",
    "audit:event-map-parity": "node scripts/check-event-map-parity.mjs",
    "test:event-map-parity": "node scripts/check-event-map-parity.mjs --self-test",
    "audit:nav-destinations": "node scripts/check-nav-manifest-destinations.mjs",
    "test:nav-destinations": "node scripts/check-nav-manifest-destinations.mjs --self-test",
    "audit:route-map-destinations": "node scripts/check-route-map-destinations.mjs",
    "test:route-map-destinations": "node scripts/check-route-map-destinations.mjs --self-test",
    "audit:ecosystem-evidence": "node scripts/check-ecosystem-release-evidence.mjs",
    "test:ecosystem-evidence": "node --test scripts/lib/jcs.test.mjs scripts/lib/edge-registry.test.mjs scripts/lib/promotion-ledger.test.mjs && node scripts/check-ecosystem-release-evidence.mjs --self-test",
    "ecosystem-evidence:generate-registry": "node scripts/check-ecosystem-release-evidence.mjs --generate-registry",
    "audit:cutover-evidence": "node scripts/check-cutover-evidence-contract.mjs",
    "audit:tools": "node scripts/check-agent-tools-manifest.mjs",
    "audit:ops": "node scripts/check-ops-registry.mjs",
    "audit:worker-db": "node scripts/check-worker-db-safety.mjs",
    "test:worker-db-safety": "node scripts/check-worker-db-safety.mjs --self-test",
    "audit:request-bodies": "go -C apps/api run ./cmd/checkrequestbodies --root .",
    "providers:preflight": "node scripts/providers/rehearsal-preflight.mjs",
    "providers:preflight:strict": "node scripts/providers/rehearsal-preflight.mjs --strict",
    "sms:callbacks:replay": "node scripts/sms-callback-replay.mjs",
    "launch:decisions": "node scripts/check-launch-decisions.mjs",
    "launch:decisions:strict": "node scripts/check-launch-decisions.mjs --strict",
    "test:load:local": "bash scripts/release/local-load-abuse.sh",
    "gate:prelaunch:local": "node scripts/prelaunch-local-gate.mjs",
    "test:e2e:docker:release": "bash scripts/release/local-docker-e2e.sh",
    "test:smoke:whitespace": "node scripts/smoke/whitespace-2026-smoke.mjs",
    "ecosystem-evidence:promote": "node scripts/check-ecosystem-release-evidence.mjs --promote",
    "audit:identity-parity": "node scripts/check-identity-surface-parity.mjs",
    "test:identity-parity": "node scripts/check-identity-surface-parity.mjs --self-test",
    "audit:optimistic-concurrency": "node scripts/check-optimistic-concurrency.mjs",
    "test:optimistic-concurrency": "node scripts/check-optimistic-concurrency.mjs --self-test",
    "audit:entitlement-denials": "node scripts/check-entitlement-denials.mjs",
    "test:entitlement-denials": "node scripts/check-entitlement-denials.mjs --self-test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.59.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "^3.3.3",
    "semver": "7.7.4",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "8.59.4",
    "yaml": "2.8.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "7.29.6",
      "@hono/node-server@<1.19.15": "1.19.15",
      "@opentelemetry/core@>=2.0.0 <2.8.0": "2.8.0",
