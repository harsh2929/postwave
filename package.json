    "patchedDependencies": {
      "next@15.5.25": "patches/next@15.5.25.patch",
      "react-native-css-interop@0.2.3": "patches/react-native-css-interop@0.2.3.patch",
      "metro@0.84.4": "patches/metro@0.84.4.patch"
    }
  },
  "dependencies": {
    "expo": "~55.0.31",
    "react": "19.2.0",
    "react-native": "0.83.10"
  }
}
