# =============================================================================
# Moosewave production environment template
# =============================================================================
#
# This file is the SOURCE OF TRUTH for what an operator needs to provision
# before the API can serve real traffic. It mirrors the tiers in
# docs/byok.md and infra/aws/OBSERVABILITY_RUNBOOK.md.
#
# How to use:
#   1. Copy this file to .env.production (NEVER commit the copy — it's
#      gitignored).
#   2. Replace every `REPLACE_ME` placeholder with a real value. After
#      filling in your values, verify nothing is unset:
#        $ grep -n REPLACE_ME .env.production
#      Should print 0 lines (or only the placeholders inside features you
#      explicitly skip — e.g. SMS, OAuth providers).
#   3. Load into your secret store (AWS Secrets Manager, ECS task def
#      `secrets` array, k8s Secret, etc.). Never paste secrets into the
#      task def's `environment` array — they end up in CloudTrail.
#
# Variable tiers:
#   Tier 0  → Boot-gating. API refuses to start without these.
#   Tier 1+ → Per-feature. The feature silently disables if unset.
#
# `# OPTIONAL` markers indicate the variable has a sensible default and
# can be left commented out. Everything else is `REPLACE_ME`.
#
# Generated commands you'll need:
#   $ openssl rand -hex 32                  # 32-byte hex (peppers, secrets)
#   $ aws kms create-key                    # platform KMS key
#   $ aws secretsmanager create-secret ...  # store the high-sensitivity ones
#
# =============================================================================


# -----------------------------------------------------------------------------
# Tier 0 — BOOT-GATING (API hard-fails at startup if missing or malformed)
# -----------------------------------------------------------------------------

# Postgres connection string. Use sslmode=require in prod. Read by the
# pgxpool initialisation in apps/api/internal/config + main.go.
DATABASE_URL=REPLACE_ME

# AWS region this replica is deployed into. MUST match POSTWAVE_DEPLOYMENT_REGION.
# Examples: us-east-1, us-west-2, eu-central-1, eu-west-1, ap-southeast-1.
AWS_REGION=REPLACE_ME

# Tenant-residency region declared by this replica. Tenants pinned to a
# different region get 421 Misdirected Request. Allowed values:
# us-east-1 | us-west-2 | eu-central-1 | eu-west-1 | ap-southeast-1 | ap-northeast-1.
POSTWAVE_DEPLOYMENT_REGION=REPLACE_ME

# Platform AWS KMS key ARN or alias. Wraps the per-tenant DEKs used for
# at-rest encryption of Postmark tokens, Slack/Discord/Teams webhook URLs,
# TOTP secrets, etc. Create with `aws kms create-key`.
# Example: arn:aws:kms:us-east-1:123456789012:alias/postwave-prod
POSTWAVE_KMS_KEY_ID=REPLACE_ME

# HMAC pepper for api_keys hashing. ≥32 bytes (hex/base64/raw). Without
# this, a DB leak of api_keys_sha256 would be brute-forceable. Generate
# with: openssl rand -hex 32
POSTWAVE_API_KEY_PEPPER=

# HMAC pepper for session/auth/magic-link signing. ≥32 bytes. Same shape
# as POSTWAVE_API_KEY_PEPPER. Generate with: openssl rand -hex 32
POSTWAVE_AUTH_HMAC_PEPPER=

# Dedicated HMAC key for consent-evidence cursor authentication and
# subject-filter binding. >=32 random bytes; never reuse auth, API-key,
# encryption, or PII-fingerprint material. Rotating this key intentionally
# invalidates active pagination cursors. Generate with: openssl rand -base64 32
POSTWAVE_CONSENT_CURSOR_SIGNING_KEY=

# Dedicated HMAC master pepper for tenant-separated shadow-PII fingerprints.
# Must be >=32 random bytes and MUST differ from auth/API-key peppers. Changing
# it requires incrementing the non-secret key version; old evidence is retained
# under its original version. Generate with: openssl rand -base64 32
POSTWAVE_PII_FINGERPRINT_PEPPER=
POSTWAVE_PII_FINGERPRINT_KEY_VERSION=v1

# Marks this deployment as production. Without "production" here, the
# boot gate's dev-kill-switch checks turn into warnings instead of fatal
# errors — set this so a leaked dev-mode flag fails closed.
POSTWAVE_ENV=production

# Authenticated client-IP boundary. Forwarded headers are accepted only when
# the immediate TCP peer falls inside one of these networks. Use the actual
# egress CIDRs of your load balancer/CDN; never use 0.0.0.0/0 or ::/0.
POSTWAVE_TRUST_FORWARDED_IP_HEADERS=1
POSTWAVE_TRUSTED_PROXY_CIDRS=REPLACE_ME
# For a rare direct-to-client listener with no L7 proxy, set trust above to 0
# and uncomment this assertion instead.
# POSTWAVE_DIRECT_CLIENT_CONNECTIONS=1

# Customer audit portal. The origin is exact (no path/query/wildcard); the
# signing secret is independent from dashboard/API auth. The SPA directory is
# bundled into the production API image. Frame ancestors is either the literal
# 'none', 'self', or a space-separated list of exact HTTPS customer origins.
POSTWAVE_PORTAL_ORIGIN=REPLACE_ME
POSTWAVE_PORTAL_JWT_SECRET=
POSTWAVE_PORTAL_SPA_DIR=/opt/postwave/audit-portal
POSTWAVE_PORTAL_FRAME_ANCESTORS='none'


# -----------------------------------------------------------------------------
# Tier 0 — Dev-mode kill-switches that MUST stay unset in production
# -----------------------------------------------------------------------------
#
# The boot gate refuses to start if any of these are set in production.
# Listed here ONLY so an operator sees the names exist and resists the
# temptation to enable them in prod. DO NOT UNCOMMENT.
#
# POSTWAVE_DEV_TENANT_SLUG_HEADER=         # tenant impersonation via header
# POSTWAVE_DEV_ADMIN_ROLE_HEADER=          # admin-role spoofing via header
# POSTWAVE_DEV_LISTMONK_WEBHOOK_BYPASS=    # skips Listmonk HMAC verification
# POSTWAVE_DEV_SHOPIFY_WEBHOOK_BYPASS=     # skips Shopify HMAC verification
# POSTWAVE_DEV_TRANSACTIONAL_SINK=         # discards campaign test sends
# POSTWAVE_DEV_OPS_OPERATOR_EMAIL=         # bypasses ops-console session+TOTP identity

# Inbound HMAC v1 does not authenticate the stable replay identity. Keep this
# false; set true only for a time-boxed sender migration with alerting on
# inbound_webhook_legacy_signature_v1_accepted_total.
POSTWAVE_ALLOW_LEGACY_INBOUND_SIGNATURE_V1=false
# Required only when the switch above is true; RFC3339 and no more than 7 days
# in the future. Startup fails closed when missing, elapsed, or too distant.
POSTWAVE_LEGACY_INBOUND_SIGNATURE_V1_EXPIRES_AT=


# -----------------------------------------------------------------------------
# Tier 1a — Outbound email (SES)
# -----------------------------------------------------------------------------

# Email backend selector. "ses" for production, "dev" for local spool.
POSTWAVE_MAILER=ses

# Region whose SES endpoint sends mail. SES production access is granted PER
# REGION (a sandboxed region silently caps you at 200/day and refuses
# unverified recipients), so this may differ from AWS_REGION. Verify with:
#   aws sesv2 get-account --region <r> --query ProductionAccessEnabled
# Falls back to AWS_REGION when unset.
AWS_SES_REGION=REPLACE_ME

# Default sender for list emails when the tenant doesn't override.
# Example: hello@yourdomain.com
POSTWAVE_DEFAULT_FROM_EMAIL=REPLACE_ME

# Fail-closed campaign delivery interlocks. Set live dispatch to true only
# after the production delivery pipeline is certified. The legacy scheduler
# flag is reserved: it cannot start the worker until durable claim recovery is
# compile-time qualified in a future release, and should remain false today.
POSTWAVE_ENABLE_CAMPAIGN_LIVE_DISPATCH=false
POSTWAVE_ENABLE_CAMPAIGN_SCHEDULER=false

# Sender for auth flows (signup verification, magic links, password reset).
# Example: "Moosewave <noreply@yourdomain.com>"
POSTWAVE_AUTH_FROM_ADDRESS=REPLACE_ME

# Sender for scheduled reports. Often the same as POSTWAVE_AUTH_FROM_ADDRESS.
POSTWAVE_REPORT_FROM_EMAIL=REPLACE_ME

# Sender for "send complete" webhook notifications.
POSTWAVE_SEND_COMPLETE_FROM=REPLACE_ME

# AWS SES configuration set name. Routes bounce/complaint events to your
# SNS topics. Create with: aws ses create-configuration-set
POSTWAVE_SES_CONFIGURATION_SET=REPLACE_ME

# Comma-separated SNS topic ARNs for SES bounce + complaint + delivery
# events. Subscribed by apps/api → bounces + complaints update the
# suppression list automatically.
# Example: arn:aws:sns:us-east-1:123:postwave-ses-bounce,arn:aws:sns:us-east-1:123:postwave-ses-complaint
POSTWAVE_SES_TOPIC_ARNS=REPLACE_ME


# -----------------------------------------------------------------------------
# Tier 1b — Inbound email (replies + provider webhooks)
# -----------------------------------------------------------------------------

# MX domain that receives VERP-encoded reply envelopes. Must have an MX
# record pointing at your SES inbound rule / Postmark inbound stream.
POSTWAVE_REPLIES_ENVELOPE_DOMAIN=REPLACE_ME

# HMAC for VERP envelope verification. Without it, anyone who knows your
# VERP scheme could forge a reply. Generate: openssl rand -hex 32
POSTWAVE_REPLIES_VERP_SECRET=

# Reply webhook secret — pick the provider you use, leave the others blank.
POSTWAVE_REPLIES_SES_SHARED_SECRET=  # if using SES inbound receipt rule
POSTWAVE_REPLIES_POSTMARK_SECRET=  # if using Postmark inbound
POSTWAVE_REPLIES_MAILGUN_SIGNING_KEY=  # if using Mailgun routes

# Dedicated HMAC key for referral-attribution cookies. Production startup
# requires at least 32 bytes and does not fall back to INTERNAL_API_TOKEN.
# Generate: openssl rand -hex 32
POSTWAVE_REFERRAL_COOKIE_SECRET=

# Custom inbound webhook/email endpoint secrets are generated per tenant in
# Postgres. Senders must use the timestamp + event-id signing contracts in
# docs/security/inbound-ingest-signing.md; there is no unsigned compatibility
# mode or global inbound secret environment variable.


# -----------------------------------------------------------------------------
# Tier 1c — Postmark transactional (approval emails, magic links)
# -----------------------------------------------------------------------------
#
# Skip this whole section if you're sending transactional via SES only.

# Postmark account-level API token (NOT the server token). Used for
# domain provisioning + DKIM record management on tenant signup.
POSTMARK_ACCOUNT_TOKEN=

# Postmark API base URL — override only for staging/testing.
# POSTMARK_BASE_URL=https://api.postmarkapp.com    # OPTIONAL

# Postmark webhook signing keys for event delivery (bounces, complaints,
# opens, clicks).
POSTWAVE_POSTMARK_HMAC_SECRET=
POSTWAVE_POSTMARK_WEBHOOK_TOKEN=


# -----------------------------------------------------------------------------
# Tier 1d — Listmonk (transactional templating + send orchestration)
# -----------------------------------------------------------------------------

# Listmonk admin URL.
LISTMONK_URL=REPLACE_ME

# Listmonk admin credentials. Strongly recommended to store these in
# AWS Secrets Manager and reference via the task def `secrets` array.
LISTMONK_USER=REPLACE_ME
LISTMONK_PASSWORD=

# Migration subscriber isolation. `shared` is the safe platform default and
# intentionally blocks Mailchimp commits. A controlled certification stack
# may use `dedicated` only with its exact Moosewave tenant UUID below.
LISTMONK_TENANT_MODE=shared
LISTMONK_DEDICATED_TENANT_ID=
# Shared secret across API, migration and automation. One isolated engine per tenant.
# JSON objects: tenant_id,destination_id,base_url,admin_user,admin_password.
# Inject from Secrets Manager. Empty uses the guarded legacy destination mode.
LISTMONK_TENANT_ROUTES=
# Migration tasks only; mount the shared EFS access point before enabling intake.
POSTWAVE_MIGRATION_UPLOAD_BACKEND=efs
POSTWAVE_MIGRATION_UPLOAD_DIR=/var/lib/postwave/migration-uploads

# Listmonk webhook HMAC secret — verifies events flowing back from
# Listmonk to the API.
LISTMONK_WEBHOOK_SECRET=

# Fallback Listmonk template ID when a tenant hasn't picked their own.
POSTWAVE_LISTMONK_DEFAULT_TEMPLATE_ID=REPLACE_ME


# -----------------------------------------------------------------------------
# Tier 1e — Other inbound webhook providers (optional, only if mounted)
# -----------------------------------------------------------------------------

# POSTWAVE_SENDGRID_HMAC_SECRET=          # OPTIONAL — SendGrid webhooks
# POSTWAVE_MAILGUN_WEBHOOK_KEY=           # OPTIONAL — Mailgun webhooks
# POSTWAVE_ARF_HMAC_SECRET=               # OPTIONAL — ARF abuse reports


# -----------------------------------------------------------------------------
# Tier 2 — Auth (magic-link works without optional Google OAuth)
# -----------------------------------------------------------------------------

# Base URL the API uses to construct OAuth callback URLs. Must match the
# redirect URI registered with Google.
# Example: https://api.yourdomain.com
POSTWAVE_OAUTH_REDIRECT_BASE=REPLACE_ME

# Cookie domain. Empty = host-only cookies. Set to ".yourdomain.com" if
# you need cross-subdomain session sharing (e.g. app + api on different
# subdomains).
POSTWAVE_COOKIE_DOMAIN=REPLACE_ME

# Public-facing origin for forms + embeds + webhook URLs the API generates.
# Example: https://api.yourdomain.com
POSTWAVE_PUBLIC_BASE_URL=REPLACE_ME
POSTWAVE_SMS_PROVIDER_CALLBACK_BASE_URL=REPLACE_ME
POSTWAVE_SMS_INBOX_CURSOR_KEY=
POSTWAVE_HELPDESK_CURSOR_KEY=
# Optional only during a controlled rotation overlap of at most one 15-minute
# cursor TTL; omit it at all other times. Never configure a placeholder key.
# POSTWAVE_SMS_INBOX_CURSOR_PREVIOUS_KEY=

# Public origin for the web UI (auth callbacks, approval links, archive
# links). Yes, this is a separate variable from POSTWAVE_PUBLIC_BASE_URL.
# Example: https://app.yourdomain.com
PUBLIC_BASE_URL=REPLACE_ME

# Public host where embedded forms render (often the web app's domain).
FORMS_PUBLIC_HOST=REPLACE_ME

# Comma-separated browser origins allowed to send credentialed API requests.
# These exact origins also form the session-cookie CSRF allowlist. Never use *.
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=REPLACE_ME

# Google OAuth — leave commented to disable.
# POSTWAVE_OAUTH_GOOGLE_CLIENT_ID=
# POSTWAVE_OAUTH_GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Tier 3 — Billing (Stripe — only if you're charging)
# -----------------------------------------------------------------------------
#
# Skip this whole section if your beta is free.

# BILLING_PROVIDER=dodo                             # canonical Moosewave billing provider
# DODO_PAYMENTS_ENVIRONMENT=live_mode               # test_mode is blocked in production
# DODO_PAYMENTS_API_KEY=                            # live business API key
# DODO_PAYMENTS_WEBHOOK_KEY=                        # whsec_... Standard Webhooks key
# DODO_PAYMENTS_WEBHOOK_KEY_SECONDARY=              # OPTIONAL — rotation grace
# DODO_PAYMENTS_PRODUCT_ID_LAUNCH_MONTHLY=          # pdt_... $39/month recurring product
# DODO_PAYMENTS_PRODUCT_ID_GROWTH_MONTHLY=          # pdt_... $99/month recurring product
# DODO_PAYMENTS_PRODUCT_ID_SCALE_MONTHLY=           # pdt_... $349/month recurring product
# MOOSEWAVE_BILLING_LAUNCH_APPROVAL=                # approved:<release-record-id>
# Legacy Stripe variables are compatibility-only; they do not select launch billing.
# STRIPE_SECRET_KEY=                                # archive tips / affiliates / legacy billing
# STRIPE_WEBHOOK_SECRET=                            # legacy subscription + archive-tip signing
# STRIPE_WEBHOOK_SECRET_SECONDARY=                  # OPTIONAL — rotation grace
# STRIPE_PRICE_SENDING=                             # legacy compatibility only
# STRIPE_PRICE_PRO=                                 # legacy compatibility only
# STRIPE_PRICE_LTD=                                 # legacy compatibility only
# STRIPE_DLQ_ALERT_EMAIL=                           # Where DLQ alerts fire


# -----------------------------------------------------------------------------
# Tier 4 — SMS (release-held; do not configure provider credentials)
# -----------------------------------------------------------------------------
# Hosted SMS sends, callbacks, A2P, billing and end-to-end MMS are source-held.
# The current adapters use process-global provider credentials and therefore
# cannot implement tenant-owned/BYO accounts. Canonical production deliberately
# supplies no Twilio/Telnyx/Bandwidth secrets. Do not add them here: activation
# requires a tenant-bound encrypted credential/account resolver, rotation and
# ownership checks plus the durable dispatch/reconciliation release gates.


# -----------------------------------------------------------------------------
# Tier 5 — Integrations
# -----------------------------------------------------------------------------

# --- Shopify ---------------------------------------------------------------
# If SHOPIFY_CLIENT_ID is set, SHOPIFY_STATE_SECRET + SHOPIFY_WEBHOOK_SECRET
# become boot-gating (Tier 0) too.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_STATE_SECRET=                     # openssl rand -hex 32
# SHOPIFY_WEBHOOK_SECRET=                   # from Shopify partner dashboard
# SHOPIFY_OAUTH_REDIRECT_URL=               # https://api.yourdomain.com/api/public/commerce/shopify/oauth/callback
# SHOPIFY_SCOPES=                           # OPTIONAL — defaults to read_customers,read_products,read_orders,read_all_orders

# --- Slack approval bot ----------------------------------------------------
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URL=                 # https://api.yourdomain.com/api/public/slack/oauth/callback
# SLACK_OAUTH_SUCCESS_REDIRECT=             # Post-install redirect in the web UI
# SLACK_SIGNING_SECRET=                     # Slack app config → Signing Secret

# --- reCAPTCHA (public form spam protection) -------------------------------
# RECAPTCHA_SECRET=                         # Google reCAPTCHA v2 checkbox secret key
# RECAPTCHA_SITE_KEY=                       # Matching public v2 checkbox site key (both are required)
# Configure both or neither. Full-mode public signup may reach a paid email-
# verification provider only after anti-abuse is proven; missing/mismatched
# deployment keys keep that path local-only and spend no provider credits.

# --- Meta social publishing + ads -----------------------------------------
# Used by the Mailchimp-compat social publishing/ad surfaces. Store tokens in
# your secret manager, not in committed env files.
# META_GRAPH_BASE_URL=https://graph.facebook.com      # OPTIONAL
# META_GRAPH_VERSION=v24.0                            # OPTIONAL
# META_PAGE_ID=                                       # Facebook Page ID
# META_PAGE_ACCESS_TOKEN=                             # Page token with publish permissions
# META_INSTAGRAM_BUSINESS_ACCOUNT_ID=                 # Connected IG Business/Creator account
# META_AD_ACCOUNT_ID=                                 # Usually act_<id> or numeric ID
# META_ADS_ACCESS_TOKEN=                              # Token with Marketing API access

# --- Google Ads remarketing -----------------------------------------------
# Per Google Ads REST docs: OAuth access token + developer-token header are
# required. login-customer-id is only needed when acting through a manager
# account; remove hyphens if setting it manually.
# GOOGLE_ADS_API_BASE_URL=https://googleads.googleapis.com     # OPTIONAL
# GOOGLE_ADS_API_VERSION=v24                                  # OPTIONAL
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=                               # OPTIONAL manager account
# GOOGLE_ADS_CUSTOMER_ID=                                     # Target customer account
# GOOGLE_OAUTH_TOKEN_URL=https://www.googleapis.com/oauth2/v3/token


# -----------------------------------------------------------------------------
# Tier 6 — Observability (strongly recommended; none block boot)
# -----------------------------------------------------------------------------

# Sentry DSNs — one per service. Operators usually create 5 separate
# Sentry projects (see infra/aws/OBSERVABILITY_RUNBOOK.md §1).
SENTRY_DSN_API=REPLACE_ME
SENTRY_DSN_AUTOMATION=REPLACE_ME
SENTRY_DSN_DELIVERABILITY=REPLACE_ME
SENTRY_DSN_MIGRATION=REPLACE_ME
SENTRY_DSN_VOICE=REPLACE_ME

# PostHog product analytics. Use the project key (phc_...), NOT the personal
# key. Self-hosted: also set POSTHOG_API_HOST.
POSTHOG_API_KEY=
# POSTHOG_API_HOST=                         # OPTIONAL — only for self-hosted PostHog

# OpenTelemetry. Endpoint format depends on backend (Honeycomb, Tempo,
# etc.). Honeycomb example: https://api.honeycomb.io:443
OTEL_EXPORTER_OTLP_ENDPOINT=REPLACE_ME
# OTEL_EXPORTER_OTLP_HEADERS=               # OPTIONAL — e.g. "x-honeycomb-team=<key>"

# Release identifier surfaced in Sentry + OTel + log lines. Bake into
# the image build: docker build --build-arg POSTWAVE_RELEASE="$(git rev-parse --short HEAD)"
POSTWAVE_RELEASE=REPLACE_ME

# Bearer token gating /metrics endpoint scraping. Without it, /metrics is
# loopback-only.
METRICS_TOKEN=


# -----------------------------------------------------------------------------
# Tier 7 — GDPR / legal (fill before going public — they surface in your DPA)
# -----------------------------------------------------------------------------

# Your company's legal name + address. Appears in the Data Processing
# Agreement, privacy policy, and GDPR export envelope.
POSTWAVE_LEGAL_ENTITY=REPLACE_ME
POSTWAVE_LEGAL_ADDRESS=REPLACE_ME

# EU Article 27 representative (required if you serve EU subjects without
# an EU establishment). Leave blank if you have an EU office.
POSTWAVE_EU_REPR_NAME=
POSTWAVE_EU_REPR_ADDRESS=

# DPA version string. Surfaces in the dashboard's DPA UI. Bump when you
# revise the contract. Example: "2026-05" or "v1.3".
POSTWAVE_DPA_VERSION=REPLACE_ME


# -----------------------------------------------------------------------------
# Tier 8 — Storage + cross-replica state
# -----------------------------------------------------------------------------

# Private S3 buckets for form uploads/assets and tenant export ZIPs. Production
# fails closed without all three bucket variables and a dedicated S3 CMK.
POSTWAVE_UPLOADS_BUCKET=REPLACE_ME
POSTWAVE_ASSETS_BUCKET=REPLACE_ME
POSTWAVE_EXPORTS_BUCKET=REPLACE_ME
POSTWAVE_S3_KMS_KEY_ID=REPLACE_ME
# Private clamd endpoint. Production startup and /api/ready fail closed when
# this is absent or unreachable; no upload is released from quarantine.
POSTWAVE_FORM_UPLOAD_CLAMAV_ADDR=REPLACE_ME
POSTWAVE_FORM_UPLOAD_TENANT_QUOTA_BYTES=1073741824
POSTWAVE_FORM_UPLOAD_PENDING_LIMIT=100

# AWS Secrets Manager backend. Set to "aws" if you want runtime secrets
# (Listmonk creds, etc.) loaded from Secrets Manager instead of env vars.
POSTWAVE_SECRETS_BACKEND=aws

# Redis URL — required if running >1 API replica (cross-replica event
# fan-out + shared rate-limit state). Without it, each replica has its
# own in-memory state.
# Example: rediss://default:password@redis.cluster.local:6379
REDIS_URL=REPLACE_ME


# -----------------------------------------------------------------------------
# Tier 9 — Sidecar service URLs (internal mTLS / VPC traffic)
# -----------------------------------------------------------------------------

# These default to localhost; override to the sidecar's service-discovery
# address (ECS Service Connect, k8s Service, etc.).
MIGRATION_SERVICE_URL=REPLACE_ME
DELIVERABILITY_SERVICE_URL=REPLACE_ME
VOICE_SERVICE_URL=REPLACE_ME
AUTOMATION_SERVICE_URL=REPLACE_ME

# Shared bearer token authenticating API → sidecar calls. Generate one
# per environment: openssl rand -hex 32
POSTWAVE_INTERNAL_API_TOKEN=


# -----------------------------------------------------------------------------
# Tier 10 — DKIM + dedicated IP routing
# -----------------------------------------------------------------------------

# Root domain that DKIM-signing subdomains are constructed under. Each
# tenant gets a `<tenant-slug>.<DKIM_ROOT_DOMAIN>` for their selector
# records.
DKIM_ROOT_DOMAIN=REPLACE_ME

# AWS region for dedicated-IP provisioning. Usually matches AWS_REGION.
DEDICATED_IP_REGION=REPLACE_ME


# -----------------------------------------------------------------------------
# Tier 11 — Affiliates + marketing redirects
# -----------------------------------------------------------------------------

# AFFILIATE_COOKIE_DOMAIN=                  # OPTIONAL — e.g. .yourdomain.com
# AFFILIATE_COOKIE_SECURE=true              # OPTIONAL — Secure cookie flag
# AFFILIATE_NOTIFY_EMAIL=                   # OPTIONAL — new-signup notification
# MARKETING_HOME_URL=https://yourdomain.com # OPTIONAL — affiliate fallback redirect


# -----------------------------------------------------------------------------
# Tier 12 — AI / safety scanning (only if you use the LLM-based safety gate)
# -----------------------------------------------------------------------------

# SAFETY_LLM_ENABLED=true                   # OPTIONAL — defaults to true
# SAFETY_LLM_MODEL=claude-haiku-4-5-20251001 # OPTIONAL — model identifier
# SAFETY_ANTHROPIC_BASE_URL=                # OPTIONAL — only for self-hosted gateway


# Campaign Assurance is a separate data plane, not an API in-process worker.
# Safe API bootstrap stays off until the digest-pinned assurance task is stable;
# then the production runbook derives a new API task for shadow/warn/block.
POSTWAVE_ENABLE_CAMPAIGN_ASSURANCE_RUNTIME=false
POSTWAVE_ENABLE_CAMPAIGN_ASSURANCE_MODELED=false
POSTWAVE_CAMPAIGN_ASSURANCE_GATE_ROLLOUT=off
# Required as an exact reviewed set before the runtime/modeled flags become
# true. The provider key and Unix sockets MUST NOT be placed in this API file.
# POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_MODEL_ID=
# POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_MODEL_VERSION=
# POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_PRICING_VERSION=
# POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_INPUT_MICROUSD_PER_MILLION_TOKENS=
# POSTWAVE_CAMPAIGN_ASSURANCE_GEMINI_OUTPUT_MICROUSD_PER_MILLION_TOKENS=
# See docs/runbooks/campaign-assurance-modeled-runtime.md and
# infra/aws/PRODUCTION_DEPLOY_RUNBOOK.md for process-specific worker/sandbox/
# gateway/image configuration and exact secret distribution.


# -----------------------------------------------------------------------------
# Tier 13 — Web Vitals reporting (browser-side performance metrics)
# -----------------------------------------------------------------------------

# Comma-separated exact browser origins allowed to POST Web Vitals data.
# This is intentionally separate from the general API CORS setting because the
# endpoint is anonymous. Wildcards are ignored. It must include every origin
# that serves a bundle configured with NEXT_PUBLIC_WEB_VITALS_ENDPOINT, and the
# same origins must remain in CORS_ALLOWED_ORIGINS because API-wide middleware
# answers browser preflight requests before the endpoint handler runs.
POSTWAVE_WEB_VITALS_ALLOWED_ORIGINS=REPLACE_ME


# -----------------------------------------------------------------------------
# Tier 14 — Optional tuning (sensible defaults exist; only override if needed)
# -----------------------------------------------------------------------------

# LOG_LEVEL=info                            # debug | info | warn | error
# PORT=8080                                 # HTTP listen port
# POSTWAVE_BLOCKLIST_AUTO_SUPPRESS=1        # Auto-suppress on bounce/complaint
# POSTWAVE_AUDIT_TRIM_INTERVAL_SECONDS=3600 # Audit log GC cadence
# POSTWAVE_AUDIT_TRIM_BATCH_SIZE=1000       # Audit log GC batch size
# POSTWAVE_RAW_PAYLOAD_RETENTION_INTERVAL_SECONDS=86400  # Raw payload TTL
# POSTWAVE_CUSTOM_FIELDS_MODE=              # Custom-fields parser mode


# -----------------------------------------------------------------------------
# Tier 15 — Internal ops console (platform-operator dashboard)
# -----------------------------------------------------------------------------
# DSN for the postwave_ops Postgres role. Migration 1700 creates the role as
# NOLOGIN with no base-table access (SECURITY DEFINER aggregate functions
# only). Grant it a login once, per environment, out of band — a password must
# never be committed to a migration:
#
#   ALTER ROLE postwave_ops LOGIN PASSWORD '<generate: openssl rand -base64 32>';
#
# Store the assembled DSN in Secrets Manager (postwave/prod/ops-db-dsn — see
# infra/aws/secrets-manager-bootstrap.json). This credential is independently
# revocable: if the ops console is ever compromised, rotate this one password
# and the customer-facing API is untouched.
# OPS_DATABASE_URL=postgres://postwave_ops:REPLACE_ME@REPLACE_ME:5432/postwave?sslmode=require
#
# Push & digest. Alerts and the daily digest go out on every configured
# channel; zero channels does not stop the boot, but logs an error at
# startup and turns the ops.push-canary check red — configure at least one.
# The webhook URL is a bearer credential: store it in Secrets Manager
# (postwave/prod/ops-slack-webhook-url — see
# infra/aws/secrets-manager-bootstrap.json) and rotate it like a secret.
# OPS_SLACK_WEBHOOK_URL=                    # Slack incoming webhook (secret)
# OPS_ALERT_EMAIL=                          # Ops alert recipient mailbox
# OPS_DIGEST_HOUR=8                         # Local hour (0-23) the daily digest sends
# OPS_TZ=UTC                                # IANA zone for the digest day boundary


# -----------------------------------------------------------------------------
# Feature kill-switches (set to "1" to disable; leave unset to enable)
# -----------------------------------------------------------------------------
# Useful for partial deploys, incident response, or shedding load.
# Verification switches are independent default-on emergency controls: unset
# or 0 leaves the runtime enabled; set exactly 1 and restart the API to disable.
# The recipient-health switch removes only the additive grade gate; canonical
# consent and active-suppression enforcement remain mandatory.

# POSTWAVE_DISABLE_VERIFICATION_BULK_JOBS=1
# POSTWAVE_DISABLE_VERIFICATION_JOB_RUNNER=1
# POSTWAVE_DISABLE_SUBSCRIBER_IMPORT_WORKER=1
# POSTWAVE_DISABLE_RECIPIENT_HEALTH_GATE=1
# POSTWAVE_DISABLE_LEAD_SCORING=1
# POSTWAVE_DISABLE_SCHEDULED_REPORTS=1
# POSTWAVE_DISABLE_AUDIT_ALERTS=1
# POSTWAVE_DISABLE_EXPORTS=1
# POSTWAVE_DISABLE_AUDIT_SINKS=1


# =============================================================================
# Validation checklist (run before deploying)
# =============================================================================
#
#   [ ] grep -n REPLACE_ME .env.production           → 0 lines OR only
#                                                       Tier 4/5 placeholders
#                                                       you intentionally skipped
#   [ ] POSTWAVE_DEPLOYMENT_REGION matches AWS_REGION matches your replica's
#       actual AWS region
#   [ ] POSTWAVE_API_KEY_PEPPER, POSTWAVE_AUTH_HMAC_PEPPER,
#       POSTWAVE_CONSENT_CURSOR_SIGNING_KEY, and
#       POSTWAVE_PII_FINGERPRINT_PEPPER are each ≥32 bytes and all DIFFERENT
#   [ ] Sender domain has SPF, DKIM, DMARC records published
#   [ ] SES production access granted (out of sandbox)
#   [ ] Migration 0173 applied to the prod DB
#   [ ] No POSTWAVE_DEV_* variables set
#   [ ] At least 2 owner/admin users seeded per tenant (two-person rule)
#
# =============================================================================
