# pnpm configuration for the Moosewave monorepo.
#
# React Native + Expo + Metro do NOT understand pnpm's symlinked virtual store.
# Metro's resolver only walks two paths and refuses to traverse `.pnpm/`,
# so any transitive package (whatwg-fetch, abort-controller, @expo/log-box,
# every internal polyfill) is invisible.
#
# Listing each transitive individually is unmaintainable — there are dozens
# of them and the list shifts every Expo SDK release. The robust fix is
# `public-hoist-pattern[]=*`: hoist EVERY transitive into the project's
# real node_modules root. pnpm's content-addressed store under `.pnpm/`
# stays the single source of truth; this just creates flat top-level
# symlinks pointing into it. Disk usage is identical to a strict layout.
#
# Tradeoff: the desktop and other workspace packages also see hoisted
# packages, which slightly relaxes pnpm's "you can only import what you
# declared" guarantee. We accept this — strictness is a CI-time concern,
# and the desktop already imports from a hand-curated short list.

public-hoist-pattern[]=*

# Strict-peer-dependencies surfaces real bugs but produces too much noise
# during workspace bootstrap. Re-enable selectively in CI later.
strict-peer-dependencies=false

# Auto-install missing peer deps (for our own packages — third-party peers
# are still required to be explicit in their own package.json).
auto-install-peers=true
