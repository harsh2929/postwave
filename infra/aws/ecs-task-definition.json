        },
        {
          "name": "POSTWAVE_AUTH_FROM_ADDRESS",
          "value": "Moosewave <noreply@moosewave.com>"
        },
        {
          "name": "POSTWAVE_DEFAULT_FROM_EMAIL",
          "value": "Moosewave <noreply@moosewave.com>"
        },
        {
          "name": "POSTWAVE_REPORT_FROM_EMAIL",
