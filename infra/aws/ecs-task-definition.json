{
  "_comment": "ecs-task-definition.json -- canonical ECS Fargate task definition for postwave-api. Register only after replacing <image-digest> with a verified sha256 digest plus every account/region/secret/config placeholder. Moving image tags are forbidden. The two role ARNs reference the IAM roles whose policies live alongside this file. Memory/CPU sizing matches the auth.go hint about argon2id memory cost: argon2id with the recommended params (m=64MiB, t=3, p=4) plus normal request memory needs comfortable headroom -- 1 vCPU / 2 GiB is the floor, not the ceiling. If p99 login latency degrades under load, raise CPU first, not memory.",
  "family": "postwave-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<account>:role/postwave-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::<account>:role/postwave-ecs-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "volumes": [
    {
      "name": "postwave-api-tmp"
    }
  ],
  "containerDefinitions": [
    {
      "name": "postwave-api",
      "image": "<account>.dkr.ecr.<region>.amazonaws.com/postwave-api@<image-digest>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "mountPoints": [
