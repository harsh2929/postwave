      "_secrets_comment": "Each ARN ends in -XXXXXX -- the 6-char Secrets-Manager-assigned suffix. Pull real ARNs with `aws secretsmanager describe-secret --secret-id postwave/prod/<name>` after running the bootstrap. The wildcard form (-*) is fine in IAM but not in valueFrom; ECS demands a fully-qualified ARN.",
      "healthCheck": {
        "_comment": "Container-level health check, evaluated by ECS independently of the ALB target group health check (alb-listener-rules.md). Both must pass for traffic to flow. interval/timeout deliberately conservative: a transient blip should not flap the task.",
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:8080/api/ready || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/postwave-api",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "api"
        }
      },
      "stopTimeout": 30,
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ],
      "readonlyRootFilesystem": true,
      "_readonly_comment": "The image root is immutable. A task-scoped ephemeral volume is mounted only at /tmp for bounded temporary workflows such as audit export staging; no temp volume is shared with another container."
    }
