{
  "_comment": "Least-privilege runtime policy for the dedicated Campaign Assurance ECS task. The worker reads frozen artifacts and stores exact-version raw model output in the uploads bucket; the image broker stores exact-version raster evidence in a separate bucket. Provider credentials and database DSNs are injected at task start by the execution role, so this runtime role deliberately has no Secrets Manager access. Model/OCR/scanner containers scrub the ECS task-credential discovery environment before exec and additionally enforce their own no-credential boundaries.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssuranceUploadsBucketControls",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": "arn:aws:s3:::<uploads-bucket-name>"
    },
    {
      "Sid": "AssuranceFrozenArtifactsAndRawOutputs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<uploads-bucket-name>/tenants/*/campaign-assurance/*"
    },
    {
      "Sid": "AssuranceImageEvidenceBucketControls",
      "Effect": "Allow",
      "Action": ["s3:GetBucketVersioning"],
      "Resource": "arn:aws:s3:::<campaign-assurance-image-evidence-bucket-name>"
    },
    {
      "Sid": "AssuranceImageEvidenceExactVersions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<campaign-assurance-image-evidence-bucket-name>/campaign-assurance/image-evidence/v1/tenants/*"
    },
    {
      "Sid": "AssuranceObjectEncryptionOnlyThroughS3",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:aws:kms:us-west-2:<account>:key/<s3-uploads-cmk-uuid>",
        "arn:aws:kms:us-west-2:<account>:key/<campaign-assurance-evidence-cmk-uuid>"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.us-west-2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ConversionIdentityProjectionEnvelopeCipher",
      "_comment": "The F03 projection worker decrypts each live conversion-ingest key only in memory and proves this exact immutable application-data key with a startup encrypt/decrypt round trip. No alias or unrelated KMS resource is accepted.",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:us-west-2:<account>:key/<app-data-cmk-uuid>"
    }
  ]
}
